  'ns-bigdata/flink-jobmanager','ns-bigdata/spark-operator-webhook-svc','default/elasticsearch','default/kibana-service',
  'monitoring/kube-stack-grafana','monitoring/kube-stack-kube-prometheus-prometheus','monitoring/loki','zabbix/zabbix-web',
  'data-infra/airflow-api-server','data-infra/trino','data-infra/superset','kube-system/kube-dns'
];
const missing = required.filter((name) => !keys.has(name));
fs.writeFileSync('reports/v11-coverage/service-omissions.json', JSON.stringify({ required, missing }, null, 2));
if (missing.length) {
  console.error('missing_services=' + missing.join(','));
  process.exit(1);
}
console.log('required_service_coverage=' + required.length);
NODE
                '''
