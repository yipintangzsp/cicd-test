// GitHub compatibility shim.
//
// The Jenkins job `github-cicd-test` still has an inline router whose persisted
// default selects this historical V11 file. That job is not configured as
// "Pipeline script from SCM", so the old V11 implementation fails at
// `checkout scm`. Keep this filename as a non-destructive compatibility entry
// and forward the GitHub job to the current V16 pipeline.

def forwardToV16 = {
    if (!fileExists('Jenkinsfile-intelligence-v16')) {
        error 'Jenkinsfile-intelligence-v16 is missing from the GitHub workspace.'
    }
    currentBuild.displayName = "#${env.BUILD_NUMBER} github v16-compat"
    currentBuild.description = 'github-v11-default-forward=Jenkinsfile-intelligence-v16'
    echo 'github-cicd-test persisted default selected Jenkinsfile-expert-v11; forwarding to Jenkinsfile-intelligence-v16.'
    load 'Jenkinsfile-intelligence-v16'
}

if (env.NODE_NAME) {
    forwardToV16()
} else {
    node {
        forwardToV16()
    }
}
