const fs = require('fs');
const services = JSON.parse(fs.readFileSync('meta/k8s-services.json', 'utf8')).items || [];
const keys = new Set(services.map((svc) => `${svc.metadata.namespace}/${svc.metadata.name}`));
const required = [
  'ns-devops/jenkins','ns-devops/gitlab-service','ns-devops/local-registry','ns-devops/portainer',
  'argocd/argocd-server','harbor/harbor-core','harbor/harbor-portal','ns-apps/hello-app','ns-apps/jkvideo-web',
