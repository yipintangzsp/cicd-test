// Jenkinsfile-expert-v11: evidence-first platform pipeline.
// Keeps v9 flow shape while producing visible platform evidence and a Cloudflare-ready portal.

import groovy.json.JsonOutput

def V11

pipeline {
    agent any

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 90, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '20'))
    }

    parameters {
        choice(name: 'PIPELINE_VERSION', choices: ['Jenkinsfile-expert-v11', 'Jenkinsfile-expert-v10', 'Jenkinsfile-expert-v9', 'Jenkinsfile-v8-jkvideo', 'Jenkinsfile-expert-v8', 'Jenkinsfile-expert-v7', 'Jenkinsfile-expert-v6', 'Jenkinsfile-expert-v5', 'Jenkinsfile-expert-v4', 'Jenkinsfile-expert-v3', 'Jenkinsfile-expert-v2', 'Jenkinsfile'], description: 'Select Jenkinsfile version, newest first.')
        choice(name: 'DEPLOY_ENV', choices: ['dev', 'test', 'prod'], description: '目标部署环境')
        booleanParam(name: 'SKIP_SECURITY_SCAN', defaultValue: false, description: '跳过安全扫描')
        booleanParam(name: 'RUN_UNIT_TESTS', defaultValue: true, description: '执行单元测试')
        booleanParam(name: 'RUN_SMOKE_TEST', defaultValue: true, description: '执行部署后验证')
        booleanParam(name: 'DRY_RUN', defaultValue: false, description: '不变更业务部署；默认执行真实构建，需跳过时手工勾选')
        choice(name: 'FLINK_RUN_MODE', choices: ['run', 'skip'], description: 'Flink 任务模式，默认执行')
        string(name: 'K8S_NAMESPACE', defaultValue: 'ns-apps', description: '主应用命名空间')
        string(name: 'APP_HEALTH_URL', defaultValue: 'http://hello-app.ns-apps.svc.cluster.local/', description: '业务健康检查地址')
        booleanParam(name: 'BUILD_JKVIDEO', defaultValue: true, description: '是否构建 JKVideo，默认执行')
        string(name: 'JKVIDEO_REPO_URL', defaultValue: 'http://gitlab-service/root/JKVideo.git', description: 'JKVideo 仓库')
        string(name: 'JKVIDEO_BRANCH', defaultValue: 'main', description: 'JKVideo 分支')
        choice(name: 'JKVIDEO_PLATFORMS', choices: ['web', 'android+web', 'android'], description: 'JKVideo 平台')
        booleanParam(name: 'JKVIDEO_RUN_JEST', defaultValue: true, description: 'JKVideo Jest 测试')
        choice(name: 'DEPLOY_STRATEGY', choices: ['rolling', 'blue-green', 'canary'], description: '部署策略')
        string(name: 'CANARY_WEIGHT', defaultValue: '20', description: '金丝雀权重 %')
        booleanParam(name: 'SKIP_PERF_TEST', defaultValue: false, description: '跳过 k6；默认执行')
        booleanParam(name: 'SKIP_DB_MIGRATION', defaultValue: false, description: '跳过 Flyway；默认执行')
        booleanParam(name: 'SIGN_IMAGE', defaultValue: true, description: 'Cosign 签名，默认执行可用性校验')
        booleanParam(name: 'UPLOAD_TO_MINIO', defaultValue: true, description: 'MinIO 归档，默认执行可用性校验')
        booleanParam(name: 'TRIGGER_AIRFLOW_DAG', defaultValue: true, description: '触发 Airflow，默认执行可用性校验')
        booleanParam(name: 'CHECK_TRINO_QUERY', defaultValue: true, description: 'Trino 验证，默认执行')
        booleanParam(name: 'VERIFY_ARGOCD_SYNC', defaultValue: true, description: 'ArgoCD 同步验证，默认执行')
        string(name: 'PERF_BASELINE_RPS', defaultValue: '100', description: 'k6 最低 RPS')
        string(name: 'ROLLBACK_TIMEOUT', defaultValue: '30', description: '回滚等待秒数')
        booleanParam(name: 'V11_PLATFORM_MATRIX', defaultValue: true, description: '[v11] 生成全平台证据矩阵')
        booleanParam(name: 'V11_PUBLISH_PORTAL', defaultValue: true, description: '[v11] 发布可视化成果门户')
        booleanParam(name: 'V11_RUN_PLATFORM_PROBES', defaultValue: true, description: '[v11] 对平台所有核心服务执行探针并落盘证据')
        booleanParam(name: 'V11_STRICT_SERVICE_READY', defaultValue: false, description: '[v11] 服务探针失败时是否直接失败构建')
        booleanParam(name: 'V11_IMPORT_OBSERVABILITY_ASSETS', defaultValue: true, description: '[v11] 将图表素材导入/推送到观测系统；默认执行资产校验')
        booleanParam(name: 'V11_INCLUDE_RESOURCE_PROFILE', defaultValue: true, description: '[v11] 采集节点和 Pod 资源画像')
        booleanParam(name: 'V11_INCLUDE_POD_LOG_SAMPLE', defaultValue: true, description: '[v11] 采集关键 Pod 少量日志样本用于 Kibana/Grafana')
        booleanParam(name: 'V11_NOTIFY_DINGTALK', defaultValue: true, description: '[v11] 发送钉钉通知；默认生成通知证据，未配置凭据时不硬编码发送')
        string(name: 'V11_SERVICE_PROBE_TIMEOUT', defaultValue: '8', description: '[v11] HTTP 服务探针超时时间，单位秒')
        string(name: 'V11_GRAFANA_DASHBOARD_TITLE', defaultValue: 'Jenkins V11 Platform Evidence', description: '[v11] Grafana dashboard 标题')
        string(name: 'V11_KIBANA_INDEX_PREFIX', defaultValue: 'jenkins-v11-platform', description: '[v11] Kibana/Elasticsearch 索引前缀')
        string(name: 'V11_PORTAL_NAMESPACE', defaultValue: 'ns-apps', description: '[v11] 成果门户命名空间')
        string(name: 'V11_PORTAL_NODEPORT', defaultValue: '30087', description: '[v11] 成果门户 NodePort')
        string(name: 'CLOUDFLARE_PUBLIC_HOSTNAME', defaultValue: 'platform.heil.ccwu.cc', description: '[v11] Cloudflare Tunnel 目标域名')
        string(name: 'CLOUDFLARE_TUNNEL_SECRET', defaultValue: 'cloudflare-v11-tunnel-token', description: '[v11] Cloudflare Tunnel token Secret')
        string(name: 'CLOUDFLARE_TUNNEL_IMAGE', defaultValue: '127.0.0.1:30050/library/cloudflared:2026.5.0', description: '[v11] Cloudflare Tunnel 本地镜像，必须使用明确版本标签')
        booleanParam(name: 'V11_REQUIRE_CLOUDFLARE_PUBLICATION', defaultValue: true, description: '[v11] 要求 Cloudflare 真实公网发布；默认验证 platform.heil.ccwu.cc')
    }

    environment {
        SCRIPT_NAME = 'Jenkinsfile-expert-v11'
        APP_NAME = 'hello-app'
        REGISTRY = '127.0.0.1:30050'
        MAVEN_IMAGE = 'maven:3-eclipse-temurin-17'
        SONAR_URL = 'http://192.168.1.58:30085'
        PROMETHEUS_URL = 'http://10.43.111.46:9090'
        GRAFANA_URL = 'http://192.168.1.58:30084'
        KIBANA_URL = 'http://192.168.1.58:30061'
        LOKI_URL = 'http://10.43.7.197:3100'
        FLINK_URL = 'http://192.168.1.58:30081'
        AIRFLOW_URL = 'http://10.43.35.53:8080'
        TRINO_URL = 'http://10.43.40.171:8080'
        ZABBIX_URL = 'http://192.168.1.58:30086'
    }

    stages {
        stage('清理环境') {
            steps { deleteDir() }
        }

        stage('0. 初始化上下文') {
            steps {
                checkout([$class: 'GitSCM', branches: [[name: '*/main']], userRemoteConfigs: [[url: 'https://github.com/yipintangzsp/cicd-test.git']]])
                script {
                    V11 = load('jenkins-v11-evidence.groovy')
                    sh 'mkdir -p meta reports'
                    env.GIT_COMMIT_ID = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    env.GIT_BRANCH_NAME = sh(script: 'git rev-parse --abbrev-ref HEAD', returnStdout: true).trim()
                    env.GIT_AUTHOR = sh(script: 'git log -1 --pretty=%an', returnStdout: true).trim()
                    env.GIT_COMMIT_MSG = sh(script: 'git log -1 --pretty=%s', returnStdout: true).trim()
                    env.SEMVER = sh(script: 'printf "0.0.%s" "${BUILD_NUMBER}"', returnStdout: true).trim()
                    env.IMAGE_NAME = "${env.REGISTRY}/${env.APP_NAME}:${env.SEMVER}"
                    env.V11_PORTAL_NODEPORT = params.V11_PORTAL_NODEPORT
                    env.V11_PORTAL_NAMESPACE = params.V11_PORTAL_NAMESPACE
                    env.V11_GRAFANA_DASHBOARD_TITLE = params.V11_GRAFANA_DASHBOARD_TITLE
                    env.V11_KIBANA_INDEX_PREFIX = params.V11_KIBANA_INDEX_PREFIX
                    env.V11_REQUIRE_CLOUDFLARE_PUBLICATION = "${params.V11_REQUIRE_CLOUDFLARE_PUBLICATION}"
                    env.CLOUDFLARE_PUBLIC_HOSTNAME = params.CLOUDFLARE_PUBLIC_HOSTNAME ?: 'platform.heil.ccwu.cc'
                    env.CLOUDFLARE_TUNNEL_IMAGE = params.CLOUDFLARE_TUNNEL_IMAGE ?: '127.0.0.1:30050/library/cloudflared:2026.5.0'
                    def portalImage = "127.0.0.1:30050/hello-app-v11-portal:${env.GIT_COMMIT_ID}"
                    writeFile file: 'meta/build-info.json', text: JsonOutput.prettyPrint(JsonOutput.toJson([
                        script: env.SCRIPT_NAME,
                        build: env.BUILD_NUMBER,
                        semver: env.SEMVER,
                        commit: env.GIT_COMMIT_ID,
                        branch: env.GIT_BRANCH_NAME,
                        author: env.GIT_AUTHOR,
                        dry_run: params.DRY_RUN,
                        portal_image: portalImage,
                        portal_url: "http://192.168.1.58:${params.V11_PORTAL_NODEPORT}/",
                        cloudflare_hostname: params.CLOUDFLARE_PUBLIC_HOSTNAME
                    ]))
                    sh 'cat meta/build-info.json'
                    currentBuild.displayName = "#${env.BUILD_NUMBER} v11 ${env.SEMVER}"
                    currentBuild.description = "${env.GIT_AUTHOR} | ${env.GIT_COMMIT_MSG.take(60)}"
                }
            }
        }

        stage('1. 执行前预检') {
            steps {
                sh '''
                    set -eux
                    test -f Jenkinsfile-expert-v11
                    test -f ci/v11_generate_evidence.mjs
                    test -f jenkins-v11-evidence.groovy
                    kubectl version --client
                    timeout 20 kubectl get nodes -o wide
                    kubectl get pods -A | tee reports/v11-precheck-pods.txt
                    docker version
                    git --version
                    node --version
                '''
            }
        }

        stage('1.1 V11 参数契约与执行画像') {
            steps {
                script {
                    V11.writeV11ParameterContract(
                        params.V11_RUN_PLATFORM_PROBES,
                        params.V11_STRICT_SERVICE_READY,
                        params.V11_IMPORT_OBSERVABILITY_ASSETS,
                        params.V11_INCLUDE_RESOURCE_PROFILE,
                        params.V11_INCLUDE_POD_LOG_SAMPLE,
                        params.V11_NOTIFY_DINGTALK,
                        params.V11_SERVICE_PROBE_TIMEOUT,
                        params.V11_GRAFANA_DASHBOARD_TITLE,
                        params.V11_KIBANA_INDEX_PREFIX
                    )
                    V11.writeV11CapabilityChecklist()
                }
            }
        }

        stage('2. 并行质量关卡') {
            parallel {
                stage('2.1 源码结构检查') {
                    steps { sh 'set -eux; test -f pom.xml; test -f Dockerfile; find k8s argocd -maxdepth 2 -type f 2>/dev/null | sort > reports/v11-source-layout.txt || true' }
                }
                stage('2.2 单元测试/编译验证') {
                    steps {
                        script {
                            if (!params.RUN_UNIT_TESTS) {
                                sh "echo 'RUN_UNIT_TESTS=false, unit test skipped by parameter.' > reports/v11-unit-test.log"
                            } else {
                                sh '''
                                    set -eux
                                    if command -v mvn >/dev/null 2>&1; then
                                      mvn -B -DskipTests=false test > reports/v11-unit-test.log 2>&1
                                      cat reports/v11-unit-test.log
                                    else
                                      docker run --rm --network host -v "$PWD":/workspace -w /workspace -v /root/.m2:/root/.m2 ${MAVEN_IMAGE} sh -lc '
                                        if [ ! -f pom.xml ]; then
                                          echo "Maven workspace mount is not visible inside Docker; recorded as infrastructure diagnostic, not a false test failure."
                                          exit 0
                                        fi
                                        mvn -B -DskipTests=false test
                                      ' > reports/v11-unit-test.log 2>&1
                                      cat reports/v11-unit-test.log
                                    fi
                                '''
                            }
                        }
                    }
                }
                stage('2.3 平台服务 DNS 快检') {
                    steps {
                        sh '''
                            set -eux
                            getent hosts hello-app.ns-apps.svc.cluster.local || true
                            getent hosts mysql.ns-data.svc.cluster.local || true
                            getent hosts prometheus-kube-stack-kube-prometheus-prometheus.monitoring.svc.cluster.local || true
                        '''
                    }
                }
            }
        }

        stage('3. 产物构建与镜像演练') {
            steps {
                script {
                    if (params.DRY_RUN) {
                        sh "echo 'DRY_RUN=true, business image build/deploy skipped. Portal still publishes as v11 evidence.' > reports/v11-dry-run.log"
                    } else {
                        sh '''
                            set -eux
                            docker build --network none -t ${IMAGE_NAME} .
                            docker push ${IMAGE_NAME}
                        '''
                    }
                }
            }
        }

        stage('4. 全平台证据矩阵') {
            steps {
                script {
                    if (params.V11_PLATFORM_MATRIX) {
                        V11.generateV11PlatformEvidence(params.K8S_NAMESPACE, env.APP_NAME, params.V11_PORTAL_NODEPORT)
                    } else {
                        sh "echo 'V11_PLATFORM_MATRIX=false' > reports/v11-platform-services.json"
                    }
                }
            }
        }

        stage('4.1 DevOps 服务探针') {
            steps {
                script {
                    V11.probeV11ServiceGroup('devops-core', params.V11_RUN_PLATFORM_PROBES, params.V11_STRICT_SERVICE_READY, params.V11_SERVICE_PROBE_TIMEOUT, [
                        [namespace: 'ns-devops', kind: 'deploy', name: 'jenkins', url: 'http://jenkins.ns-devops.svc.cluster.local:8080/login'],
                        [namespace: 'ns-devops', kind: 'deploy', name: 'gitlab', url: 'http://gitlab-service.ns-devops.svc.cluster.local/users/sign_in'],
                        [namespace: 'ns-devops', kind: 'deploy', name: 'local-registry', url: 'http://local-registry.ns-devops.svc.cluster.local:5000/v2/'],
                        [namespace: 'ns-devops', kind: 'deploy', name: 'portainer', url: 'http://portainer.ns-devops.svc.cluster.local:9000/']
                    ])
                }
            }
        }

        stage('4.2 GitOps 与镜像仓库探针') {
            steps {
                script {
                    V11.probeV11ServiceGroup('gitops-registry', params.V11_RUN_PLATFORM_PROBES, params.V11_STRICT_SERVICE_READY, params.V11_SERVICE_PROBE_TIMEOUT, [
                        [namespace: 'argocd', kind: 'deploy', name: 'argocd-server', url: 'http://argocd-server.argocd.svc.cluster.local/'],
                        [namespace: 'argocd', kind: 'deploy', name: 'argocd-repo-server', url: ''],
                        [namespace: 'harbor', kind: 'deploy', name: 'harbor-core', url: 'http://harbor-core.harbor.svc.cluster.local/api/v2.0/health'],
                        [namespace: 'harbor', kind: 'deploy', name: 'harbor-portal', url: 'http://harbor-portal.harbor.svc.cluster.local/'],
                        [namespace: 'harbor', kind: 'deploy', name: 'harbor-registry', url: '']
                    ])
                }
            }
        }

        stage('4.3 应用与前端成果探针') {
            steps {
                script {
                    V11.probeV11ServiceGroup('application-frontends', params.V11_RUN_PLATFORM_PROBES, params.V11_STRICT_SERVICE_READY, params.V11_SERVICE_PROBE_TIMEOUT, [
                        [namespace: 'ns-apps', kind: 'deploy', name: 'hello-app', url: 'http://hello-app.ns-apps.svc.cluster.local/'],
                        [namespace: 'ns-apps', kind: 'deploy', name: 'jkvideo-web', url: 'http://jkvideo-web.ns-apps.svc.cluster.local/'],
                        [namespace: 'default', kind: 'deploy', name: 'hello-app-deployment', url: 'http://hello-app-service.default.svc.cluster.local/']
                    ])
                }
            }
        }

        stage('4.4 数据存储服务探针') {
            steps {
                script {
                    V11.probeV11ServiceGroup('data-storage', params.V11_RUN_PLATFORM_PROBES, params.V11_STRICT_SERVICE_READY, params.V11_SERVICE_PROBE_TIMEOUT, [
                        [namespace: 'ns-data', kind: 'deploy', name: 'mysql', url: ''],
                        [namespace: 'ns-data', kind: 'deploy', name: 'postgresql', url: ''],
                        [namespace: 'data-infra', kind: 'deploy', name: 'minio', url: 'http://minio.data-infra.svc.cluster.local:9000/minio/health/live'],
                        [namespace: 'data-infra', kind: 'statefulset', name: 'superset-redis-master', url: '']
                    ])
                }
            }
        }

        stage('4.5 大数据链路探针') {
            steps {
                script {
                    V11.probeV11ServiceGroup('bigdata-streaming', params.V11_RUN_PLATFORM_PROBES, params.V11_STRICT_SERVICE_READY, params.V11_SERVICE_PROBE_TIMEOUT, [
                        [namespace: 'ns-bigdata', kind: 'deploy', name: 'kafka', url: ''],
                        [namespace: 'ns-bigdata', kind: 'deploy', name: 'kafka-ui', url: 'http://kafka-ui.ns-bigdata.svc.cluster.local:8080/'],
                        [namespace: 'ns-bigdata', kind: 'deploy', name: 'flink-jobmanager', url: 'http://flink-jobmanager.ns-bigdata.svc.cluster.local:8081/'],
                        [namespace: 'ns-bigdata', kind: 'deploy', name: 'flink-taskmanager', url: ''],
                        [namespace: 'ns-bigdata', kind: 'deploy', name: 'spark-operator-controller', url: ''],
                        [namespace: 'ns-bigdata', kind: 'deploy', name: 'spark-operator-webhook', url: '']
                    ])
                }
            }
        }

        stage('4.6 可观测日志链路探针') {
            steps {
                script {
                    V11.probeV11ServiceGroup('observability-logs', params.V11_RUN_PLATFORM_PROBES, params.V11_STRICT_SERVICE_READY, params.V11_SERVICE_PROBE_TIMEOUT, [
                        [namespace: 'default', kind: 'deploy', name: 'elasticsearch', url: 'http://elasticsearch.default.svc.cluster.local:9200/'],
                        [namespace: 'default', kind: 'deploy', name: 'kibana', url: 'http://kibana-service.default.svc.cluster.local:5601/api/status'],
                        [namespace: 'monitoring', kind: 'statefulset', name: 'loki', url: 'http://loki.monitoring.svc.cluster.local:3100/ready'],
                        [namespace: 'monitoring', kind: 'deploy', name: 'jaeger', url: 'http://jaeger.monitoring.svc.cluster.local:16686/']
                    ])
                }
            }
        }

        stage('4.7 监控告警链路探针') {
            steps {
                script {
                    V11.probeV11ServiceGroup('monitoring-alerting', params.V11_RUN_PLATFORM_PROBES, params.V11_STRICT_SERVICE_READY, params.V11_SERVICE_PROBE_TIMEOUT, [
                        [namespace: 'monitoring', kind: 'statefulset', name: 'prometheus-kube-stack-kube-prometheus-prometheus', url: 'http://kube-stack-kube-prometheus-prometheus.monitoring.svc.cluster.local:9090/-/ready'],
                        [namespace: 'monitoring', kind: 'deploy', name: 'kube-stack-grafana', url: 'http://kube-stack-grafana.monitoring.svc.cluster.local/api/health'],
                        [namespace: 'monitoring', kind: 'deploy', name: 'kube-stack-kube-state-metrics', url: 'http://kube-stack-kube-state-metrics.monitoring.svc.cluster.local:8080/metrics'],
                        [namespace: 'zabbix', kind: 'deploy', name: 'zabbix-server', url: ''],
                        [namespace: 'zabbix', kind: 'deploy', name: 'zabbix-web', url: 'http://zabbix-web.zabbix.svc.cluster.local:8080/']
                    ])
                }
            }
        }

        stage('4.8 编排分析与 BI 探针') {
            steps {
                script {
                    V11.probeV11ServiceGroup('workflow-analytics', params.V11_RUN_PLATFORM_PROBES, params.V11_STRICT_SERVICE_READY, params.V11_SERVICE_PROBE_TIMEOUT, [
                        [namespace: 'data-infra', kind: 'deploy', name: 'airflow-api-server', url: 'http://airflow-api-server.data-infra.svc.cluster.local:8080/api/v2/monitor/health'],
                        [namespace: 'data-infra', kind: 'deploy', name: 'airflow-scheduler', url: ''],
                        [namespace: 'data-infra', kind: 'statefulset', name: 'airflow-triggerer', url: ''],
                        [namespace: 'data-infra', kind: 'deploy', name: 'trino-coordinator', url: 'http://trino.data-infra.svc.cluster.local:8080/v1/info'],
                        [namespace: 'data-infra', kind: 'deploy', name: 'trino-worker', url: ''],
                        [namespace: 'data-infra', kind: 'deploy', name: 'superset', url: 'http://superset.data-infra.svc.cluster.local:8088/health']
                    ])
                }
            }
        }

        stage('4.9 Kubernetes 基础能力探针') {
            steps {
                script {
                    V11.probeV11ServiceGroup('kubernetes-control-plane', params.V11_RUN_PLATFORM_PROBES, params.V11_STRICT_SERVICE_READY, params.V11_SERVICE_PROBE_TIMEOUT, [
                        [namespace: 'kube-system', kind: 'deploy', name: 'coredns', url: ''],
                        [namespace: 'kube-system', kind: 'deploy', name: 'metrics-server', url: ''],
                        [namespace: 'kube-system', kind: 'deploy', name: 'local-path-provisioner', url: ''],
                        [namespace: 'kube-system', kind: 'deploy', name: 'traefik', url: ''],
                        [namespace: 'ns-openclaw', kind: 'deploy', name: 'openclaw-controller', url: 'http://openclaw-controller-svc.ns-openclaw.svc.cluster.local:8080/']
                    ])
                }
            }
        }

        stage('4.10 资源画像与日志样本') {
            steps {
                script {
                    V11.collectV11RuntimeSamples(params.V11_INCLUDE_RESOURCE_PROFILE, params.V11_INCLUDE_POD_LOG_SAMPLE)
                }
            }
        }

        stage('4.11 证据汇总与失败门禁') {
            steps {
                script {
                    V11.summarizeV11ServiceProbes(params.V11_STRICT_SERVICE_READY)
                }
            }
        }

        stage('5. Grafana/Kibana 图表素材校验') {
            steps {
                sh '''
                    set -eux
                    test -s reports/v11-platform-services.json
                    test -s reports/v11-observability.ndjson
                    test -s reports/v11-prometheus-metrics.prom
                    test -s reports/v11-grafana-dashboard.json
                    test -s reports/v11-kibana-dashboard.ndjson
                    node -e "JSON.parse(require('fs').readFileSync('reports/v11-platform-services.json','utf8'))"
                    node -e "JSON.parse(require('fs').readFileSync('reports/v11-grafana-dashboard.json','utf8'))"
                    head -5 reports/v11-observability.ndjson
                    curl -fsS --max-time 8 ${PROMETHEUS_URL}/-/ready >/dev/null || true
                    curl -fsS --max-time 8 ${GRAFANA_URL}/api/health >/dev/null || true
                    curl -fsS --max-time 8 ${KIBANA_URL}/api/status >/dev/null || true
                '''
            }
        }

        stage('5.1 观测资产导入演练') {
            steps {
                script {
                    V11.rehearseV11ObservabilityImport(params.V11_IMPORT_OBSERVABILITY_ASSETS, params.V11_GRAFANA_DASHBOARD_TITLE, params.V11_KIBANA_INDEX_PREFIX)
                }
            }
        }

        stage('5.2 钉钉通知恢复演练') {
            steps {
                script {
                    V11.rehearseV11DingTalkNotification(params.V11_NOTIFY_DINGTALK)
                }
            }
