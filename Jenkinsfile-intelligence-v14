def p(String name, Object fallbackValue) {
    return params.containsKey(name) && params[name] != null ? params[name] : fallbackValue
}

def refreshWorkspace = {
    if (env.JOB_NAME == 'github-cicd-test') {
        sh '''
            set -eux
            git clone /var/jenkins_home/github-cache/cicd-test.git .
            git checkout -f main
            git remote set-url origin https://github.com/yipintangzsp/cicd-test.git
        '''
    } else {
        checkout scm
    }
}

def runV14 = {
    timeout(time: 210, unit: 'MINUTES') {
        timestamps {
            try {
                stage('V14.00 运行 V13 Foundation') {
                    if ("${p('V14_RUN_V13_FOUNDATION', false)}" == 'true') {
                        load 'Jenkinsfile-epoch-v13'
                    } else {
                        echo 'V14_RUN_V13_FOUNDATION=false: skip full V13 rerun and inherit live V13/V14 evidence from portal baseline.'
                    }
                }

                stage('V14.01 重新载入源码') {
                    deleteDir()
                    refreshWorkspace()
                    sh 'mkdir -p meta reports/v14-baseline reports/v14-intelligence reports/v14-portal reports/v14-observability-import reports/v14-stage-manifest'
                    env.SCRIPT_NAME = 'Jenkinsfile-intelligence-v14'
                    env.APP_NAME = 'platform-intelligence-v14'
