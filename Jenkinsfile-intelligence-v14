}
JSON
                        curl -fsS -X PUT "${ES_URL}/${INDEX_NAME}" -H 'Content-Type: application/json' --data-binary @reports/v14-observability-import/mapping.json -o reports/v14-observability-import/create-index.json || true
                        node - <<'NODE'
const fs = require('fs');
const crypto = require('crypto');
const index = process.env.INDEX_NAME;
const input = fs.readFileSync('reports/v14-observability.ndjson','utf8').split('\n').filter(Boolean);
const out = [];
input.forEach((line, i) => {
  const doc = JSON.parse(line);
  const source = [doc.pipeline_version, doc.build, doc.type, doc.category, doc.name, doc.key, i].join('|');
  const id = crypto.createHash('sha1').update(source).digest('hex');
  out.push(JSON.stringify({ index: { _index: index, _id: id } }));
  out.push(JSON.stringify(doc));
});
fs.writeFileSync('reports/v14-observability-import/bulk.ndjson', out.join('\n') + '\n');
console.log('v14_bulk_events=' + input.length);
