// Jenkinsfile-expert-v10: evidence-first platform pipeline.
// Keeps v9 flow shape while producing visible platform evidence and a Cloudflare-ready portal.

import groovy.json.JsonOutput

def V10

pipeline {
    agent any

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 90, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '20'))
    }

    parameters {
        choice(name: 'PIPELINE_VERSION', choices: ['Jenkinsfile-expert-v10', 'Jenkinsfile-expert-v9', 'Jenkinsfile-v8-jkvideo', 'Jenkinsfile-expert-v8', 'Jenkinsfile-expert-v7', 'Jenkinsfile-expert-v6', 'Jenkinsfile-expert-v5', 'Jenkinsfile-expert-v4', 'Jenkinsfile-expert-v3', 'Jenkinsfile-expert-v2', 'Jenkinsfile'], description: 'Select Jenkinsfile version, newest first.')
        choice(name: 'DEPLOY_ENV', choices: ['dev', 'test', 'prod'], description: '目标部署环境')
        booleanParam(name: 'SKIP_SECURITY_SCAN', defaultValue: false, description: '跳过安全扫描')
        booleanParam(name: 'RUN_UNIT_TESTS', defaultValue: true, description: '执行单元测试')
        booleanParam(name: 'RUN_SMOKE_TEST', defaultValue: true, description: '执行部署后验证')
        booleanParam(name: 'DRY_RUN', defaultValue: false, description: '不变更业务部署；默认执行真实构建，需跳过时手工勾选')
        choice(name: 'FLINK_RUN_MODE', choices: ['run', 'skip'], description: 'Flink 任务模式，默认执行')
        string(name: 'K8S_NAMESPACE', defaultValue: 'ns-apps', description: '主应用命名空间')
        string(name: 'APP_HEALTH_URL', defaultValue: 'http://hello-app.ns-apps.svc.cluster.local/', description: '业务健康检查地址')
        booleanParam(name: 'BUILD_JKVIDEO', defaultValue: true, description: '是否构建 JKVideo，默认执行')
        string(name: 'JKVIDEO_REPO_URL', defaultValue: 'http://gitlab-service/root/JKVideo.git', description: 'JKVideo 仓库')
        string(name: 'JKVIDEO_BRANCH', defaultValue: 'main', description: 'JKVideo 分支')
        choice(name: 'JKVIDEO_PLATFORMS', choices: ['web', 'android+web', 'android'], description: 'JKVideo 平台')
        booleanParam(name: 'JKVIDEO_RUN_JEST', defaultValue: true, description: 'JKVideo Jest 测试')
        choice(name: 'DEPLOY_STRATEGY', choices: ['rolling', 'blue-green', 'canary'], description: '部署策略')
        string(name: 'CANARY_WEIGHT', defaultValue: '20', description: '金丝雀权重 %')
        booleanParam(name: 'SKIP_PERF_TEST', defaultValue: false, description: '跳过 k6；默认执行')
        booleanParam(name: 'SKIP_DB_MIGRATION', defaultValue: false, description: '跳过 Flyway；默认执行')
        booleanParam(name: 'SIGN_IMAGE', defaultValue: true, description: 'Cosign 签名，默认执行可用性校验')
        booleanParam(name: 'UPLOAD_TO_MINIO', defaultValue: true, description: 'MinIO 归档，默认执行可用性校验')
        booleanParam(name: 'TRIGGER_AIRFLOW_DAG', defaultValue: true, description: '触发 Airflow，默认执行可用性校验')
        booleanParam(name: 'CHECK_TRINO_QUERY', defaultValue: true, description: 'Trino 验证，默认执行')
        booleanParam(name: 'VERIFY_ARGOCD_SYNC', defaultValue: true, description: 'ArgoCD 同步验证，默认执行')
        string(name: 'PERF_BASELINE_RPS', defaultValue: '100', description: 'k6 最低 RPS')
        string(name: 'ROLLBACK_TIMEOUT', defaultValue: '30', description: '回滚等待秒数')
        booleanParam(name: 'V10_PLATFORM_MATRIX', defaultValue: true, description: '[v10] 生成全平台证据矩阵')
        booleanParam(name: 'V10_PUBLISH_PORTAL', defaultValue: true, description: '[v10] 发布可视化成果门户')
        booleanParam(name: 'V10_RUN_PLATFORM_PROBES', defaultValue: true, description: '[v10] 对平台所有核心服务执行探针并落盘证据')
        booleanParam(name: 'V10_STRICT_SERVICE_READY', defaultValue: false, description: '[v10] 服务探针失败时是否直接失败构建')
        booleanParam(name: 'V10_IMPORT_OBSERVABILITY_ASSETS', defaultValue: true, description: '[v10] 将图表素材导入/推送到观测系统；默认执行资产校验')
        booleanParam(name: 'V10_INCLUDE_RESOURCE_PROFILE', defaultValue: true, description: '[v10] 采集节点和 Pod 资源画像')
        booleanParam(name: 'V10_INCLUDE_POD_LOG_SAMPLE', defaultValue: true, description: '[v10] 采集关键 Pod 少量日志样本用于 Kibana/Grafana')
        booleanParam(name: 'V10_NOTIFY_DINGTALK', defaultValue: true, description: '[v10] 发送钉钉通知；默认生成通知证据，未配置凭据时不硬编码发送')
        string(name: 'V10_SERVICE_PROBE_TIMEOUT', defaultValue: '8', description: '[v10] HTTP 服务探针超时时间，单位秒')
        string(name: 'V10_GRAFANA_DASHBOARD_TITLE', defaultValue: 'Jenkins V10 Platform Evidence', description: '[v10] Grafana dashboard 标题')
        string(name: 'V10_KIBANA_INDEX_PREFIX', defaultValue: 'jenkins-v10-platform', description: '[v10] Kibana/Elasticsearch 索引前缀')
        string(name: 'V10_PORTAL_NAMESPACE', defaultValue: 'ns-apps', description: '[v10] 成果门户命名空间')
        string(name: 'V10_PORTAL_NODEPORT', defaultValue: '30087', description: '[v10] 成果门户 NodePort')
        string(name: 'CLOUDFLARE_PUBLIC_HOSTNAME', defaultValue: 'platform.heil.ccwu.cc', description: '[v10] Cloudflare Tunnel 目标域名')
        string(name: 'CLOUDFLARE_TUNNEL_SECRET', defaultValue: 'cloudflare-v10-tunnel-token', description: '[v10] Cloudflare Tunnel token Secret')
        string(name: 'CLOUDFLARE_TUNNEL_IMAGE', defaultValue: '127.0.0.1:30050/library/cloudflared:latest', description: '[v10] Cloudflare Tunnel 本地镜像')
        booleanParam(name: 'V10_REQUIRE_CLOUDFLARE_PUBLICATION', defaultValue: true, description: '[v10] 要求 Cloudflare 真实公网发布；默认验证 platform.heil.ccwu.cc')
    }

    environment {
        SCRIPT_NAME = 'Jenkinsfile-expert-v10'
        APP_NAME = 'hello-app'
        REGISTRY = '127.0.0.1:30050'
        MAVEN_IMAGE = 'maven:3-eclipse-temurin-17'
        SONAR_URL = 'http://192.168.1.58:30085'
        PROMETHEUS_URL = 'http://10.43.111.46:9090'
        GRAFANA_URL = 'http://192.168.1.58:30084'
        KIBANA_URL = 'http://192.168.1.58:30061'
        LOKI_URL = 'http://10.43.7.197:3100'
        FLINK_URL = 'http://192.168.1.58:30081'
        AIRFLOW_URL = 'http://10.43.35.53:8080'
        TRINO_URL = 'http://10.43.40.171:8080'
        ZABBIX_URL = 'http://192.168.1.58:30086'
    }

    stages {
        stage('清理环境') {
            steps { deleteDir() }
        }

        stage('0. 初始化上下文') {
            steps {
                checkout([$class: 'GitSCM', branches: [[name: '*/main']], userRemoteConfigs: [[url: '/var/jenkins_home/github-cache/cicd-test.git']]])
                script {
                    V10 = load('jenkins-v10-evidence.groovy')
                    sh 'mkdir -p meta reports'
                    env.GIT_COMMIT_ID = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    env.GIT_BRANCH_NAME = sh(script: 'git rev-parse --abbrev-ref HEAD', returnStdout: true).trim()
                    env.GIT_AUTHOR = sh(script: 'git log -1 --pretty=%an', returnStdout: true).trim()
                    env.GIT_COMMIT_MSG = sh(script: 'git log -1 --pretty=%s', returnStdout: true).trim()
                    env.SEMVER = sh(script: 'printf "0.0.%s" "${BUILD_NUMBER}"', returnStdout: true).trim()
                    env.IMAGE_NAME = "${env.REGISTRY}/${env.APP_NAME}:${env.SEMVER}"
                    env.V10_PORTAL_NODEPORT = params.V10_PORTAL_NODEPORT
                    env.CLOUDFLARE_PUBLIC_HOSTNAME = params.CLOUDFLARE_PUBLIC_HOSTNAME ?: 'platform.heil.ccwu.cc'
                    def portalImage = "127.0.0.1:30050/hello-app-v10-portal:${env.GIT_COMMIT_ID}"
                    writeFile file: 'meta/build-info.json', text: JsonOutput.prettyPrint(JsonOutput.toJson([
                        script: env.SCRIPT_NAME,
                        build: env.BUILD_NUMBER,
                        semver: env.SEMVER,
                        commit: env.GIT_COMMIT_ID,
                        branch: env.GIT_BRANCH_NAME,
                        author: env.GIT_AUTHOR,
                        dry_run: params.DRY_RUN,
                        portal_image: portalImage,
                        portal_url: "http://192.168.1.58:${params.V10_PORTAL_NODEPORT}/",
                        cloudflare_hostname: params.CLOUDFLARE_PUBLIC_HOSTNAME
                    ]))
                    sh 'cat meta/build-info.json'
                    currentBuild.displayName = "#${env.BUILD_NUMBER} v10 ${env.SEMVER}"
                    currentBuild.description = "${env.GIT_AUTHOR} | ${env.GIT_COMMIT_MSG.take(60)}"
                }
            }
        }

        stage('1. 执行前预检') {
            steps {
                sh '''
                    set -eux
                    test -f Jenkinsfile-expert-v10
                    test -f ci/v10_generate_evidence.mjs
                    test -f jenkins-v10-evidence.groovy
                    kubectl version --client
                    timeout 20 kubectl get nodes -o wide
                    kubectl get pods -A | tee reports/v10-precheck-pods.txt
                    docker version
                    git --version
                    node --version
                '''
            }
        }

        stage('1.1 V10 参数契约与执行画像') {
            steps {
                script {
                    V10.writeV10ParameterContract(
                        params.V10_RUN_PLATFORM_PROBES,
                        params.V10_STRICT_SERVICE_READY,
                        params.V10_IMPORT_OBSERVABILITY_ASSETS,
                        params.V10_INCLUDE_RESOURCE_PROFILE,
                        params.V10_INCLUDE_POD_LOG_SAMPLE,
                        params.V10_NOTIFY_DINGTALK,
                        params.V10_SERVICE_PROBE_TIMEOUT,
                        params.V10_GRAFANA_DASHBOARD_TITLE,
                        params.V10_KIBANA_INDEX_PREFIX
                    )
                    V10.writeV10CapabilityChecklist()
                }
            }
        }

        stage('2. 并行质量关卡') {
            parallel {
                stage('2.1 源码结构检查') {
                    steps { sh 'set -eux; test -f pom.xml; test -f Dockerfile; find k8s argocd -maxdepth 2 -type f 2>/dev/null | sort > reports/v10-source-layout.txt || true' }
                }
                stage('2.2 单元测试/编译验证') {
                    steps {
                        script {
                            if (!params.RUN_UNIT_TESTS) {
                                sh "echo 'RUN_UNIT_TESTS=false, unit test skipped by parameter.' > reports/v10-unit-test.log"
                            } else {
                                sh '''
                                    set -eux
                                    docker run --rm --network host -v "$PWD":/workspace -w /workspace -v /root/.m2:/root/.m2 ${MAVEN_IMAGE} mvn -B -DskipTests=false test | tee reports/v10-unit-test.log
                                '''
                            }
                        }
                    }
                }
                stage('2.3 平台服务 DNS 快检') {
                    steps {
                        sh '''
                            set -eux
                            getent hosts hello-app.ns-apps.svc.cluster.local || true
                            getent hosts mysql.ns-data.svc.cluster.local || true
                            getent hosts prometheus-kube-stack-kube-prometheus-prometheus.monitoring.svc.cluster.local || true
                        '''
                    }
                }
            }
        }

        stage('3. 产物构建与镜像演练') {
            steps {
                script {
                    if (params.DRY_RUN) {
                        sh "echo 'DRY_RUN=true, business image build/deploy skipped. Portal still publishes as v10 evidence.' > reports/v10-dry-run.log"
                    } else {
                        sh '''
                            set -eux
                            docker build --network none -t ${IMAGE_NAME} .
                            docker push ${IMAGE_NAME}
                        '''
                    }
                }
            }
        }

        stage('4. 全平台证据矩阵') {
            steps {
                script {
                    if (params.V10_PLATFORM_MATRIX) {
                        V10.generateV10PlatformEvidence(params.K8S_NAMESPACE, env.APP_NAME, params.V10_PORTAL_NODEPORT)
                    } else {
                        sh "echo 'V10_PLATFORM_MATRIX=false' > reports/v10-platform-services.json"
                    }
                }
            }
        }

        stage('4.1 DevOps 服务探针') {
            steps {
                script {
                    V10.probeV10ServiceGroup('devops-core', params.V10_RUN_PLATFORM_PROBES, params.V10_STRICT_SERVICE_READY, params.V10_SERVICE_PROBE_TIMEOUT, [
                        [namespace: 'ns-devops', kind: 'deploy', name: 'jenkins', url: 'http://jenkins.ns-devops.svc.cluster.local:8080/login'],
                        [namespace: 'ns-devops', kind: 'deploy', name: 'gitlab', url: 'http://gitlab-service.ns-devops.svc.cluster.local/users/sign_in'],
                        [namespace: 'ns-devops', kind: 'deploy', name: 'local-registry', url: 'http://local-registry.ns-devops.svc.cluster.local:5000/v2/'],
                        [namespace: 'ns-devops', kind: 'deploy', name: 'portainer', url: 'http://portainer.ns-devops.svc.cluster.local:9000/']
                    ])
                }
            }
        }

        stage('4.2 GitOps 与镜像仓库探针') {
            steps {
                script {
                    V10.probeV10ServiceGroup('gitops-registry', params.V10_RUN_PLATFORM_PROBES, params.V10_STRICT_SERVICE_READY, params.V10_SERVICE_PROBE_TIMEOUT, [
                        [namespace: 'argocd', kind: 'deploy', name: 'argocd-server', url: 'http://argocd-server.argocd.svc.cluster.local/'],
                        [namespace: 'argocd', kind: 'deploy', name: 'argocd-repo-server', url: ''],
                        [namespace: 'harbor', kind: 'deploy', name: 'harbor-core', url: 'http://harbor-core.harbor.svc.cluster.local/api/v2.0/health'],
                        [namespace: 'harbor', kind: 'deploy', name: 'harbor-portal', url: 'http://harbor-portal.harbor.svc.cluster.local/'],
                        [namespace: 'harbor', kind: 'deploy', name: 'harbor-registry', url: '']
                    ])
                }
            }
        }

        stage('4.3 应用与前端成果探针') {
            steps {
                script {
                    V10.probeV10ServiceGroup('application-frontends', params.V10_RUN_PLATFORM_PROBES, params.V10_STRICT_SERVICE_READY, params.V10_SERVICE_PROBE_TIMEOUT, [
                        [namespace: 'ns-apps', kind: 'deploy', name: 'hello-app', url: 'http://hello-app.ns-apps.svc.cluster.local/'],
                        [namespace: 'ns-apps', kind: 'deploy', name: 'jkvideo-web', url: 'http://jkvideo-web.ns-apps.svc.cluster.local/'],
                        [namespace: 'default', kind: 'deploy', name: 'hello-app-deployment', url: 'http://hello-app-service.default.svc.cluster.local/']
                    ])
                }
            }
        }

        stage('4.4 数据存储服务探针') {
            steps {
                script {
                    V10.probeV10ServiceGroup('data-storage', params.V10_RUN_PLATFORM_PROBES, params.V10_STRICT_SERVICE_READY, params.V10_SERVICE_PROBE_TIMEOUT, [
                        [namespace: 'ns-data', kind: 'deploy', name: 'mysql', url: ''],
                        [namespace: 'ns-data', kind: 'deploy', name: 'postgresql', url: ''],
                        [namespace: 'data-infra', kind: 'deploy', name: 'minio', url: 'http://minio.data-infra.svc.cluster.local:9000/minio/health/live'],
                        [namespace: 'data-infra', kind: 'statefulset', name: 'superset-redis-master', url: '']
                    ])
                }
            }
        }

        stage('4.5 大数据链路探针') {
            steps {
                script {
                    V10.probeV10ServiceGroup('bigdata-streaming', params.V10_RUN_PLATFORM_PROBES, params.V10_STRICT_SERVICE_READY, params.V10_SERVICE_PROBE_TIMEOUT, [
                        [namespace: 'ns-bigdata', kind: 'deploy', name: 'kafka', url: ''],
                        [namespace: 'ns-bigdata', kind: 'deploy', name: 'kafka-ui', url: 'http://kafka-ui.ns-bigdata.svc.cluster.local:8080/'],
                        [namespace: 'ns-bigdata', kind: 'deploy', name: 'flink-jobmanager', url: 'http://flink-jobmanager.ns-bigdata.svc.cluster.local:8081/'],
                        [namespace: 'ns-bigdata', kind: 'deploy', name: 'flink-taskmanager', url: ''],
                        [namespace: 'ns-bigdata', kind: 'deploy', name: 'spark-operator-controller', url: ''],
                        [namespace: 'ns-bigdata', kind: 'deploy', name: 'spark-operator-webhook', url: '']
                    ])
                }
            }
        }

        stage('4.6 可观测日志链路探针') {
            steps {
                script {
                    V10.probeV10ServiceGroup('observability-logs', params.V10_RUN_PLATFORM_PROBES, params.V10_STRICT_SERVICE_READY, params.V10_SERVICE_PROBE_TIMEOUT, [
                        [namespace: 'default', kind: 'deploy', name: 'elasticsearch', url: 'http://elasticsearch.default.svc.cluster.local:9200/'],
                        [namespace: 'default', kind: 'deploy', name: 'kibana', url: 'http://kibana-service.default.svc.cluster.local:5601/api/status'],
                        [namespace: 'monitoring', kind: 'statefulset', name: 'loki', url: 'http://loki.monitoring.svc.cluster.local:3100/ready'],
                        [namespace: 'monitoring', kind: 'deploy', name: 'jaeger', url: 'http://jaeger.monitoring.svc.cluster.local:16686/']
                    ])
                }
            }
        }

        stage('4.7 监控告警链路探针') {
            steps {
                script {
                    V10.probeV10ServiceGroup('monitoring-alerting', params.V10_RUN_PLATFORM_PROBES, params.V10_STRICT_SERVICE_READY, params.V10_SERVICE_PROBE_TIMEOUT, [
                        [namespace: 'monitoring', kind: 'statefulset', name: 'prometheus-kube-stack-kube-prometheus-prometheus', url: 'http://kube-stack-kube-prometheus-prometheus.monitoring.svc.cluster.local:9090/-/ready'],
                        [namespace: 'monitoring', kind: 'deploy', name: 'kube-stack-grafana', url: 'http://kube-stack-grafana.monitoring.svc.cluster.local/api/health'],
                        [namespace: 'monitoring', kind: 'deploy', name: 'kube-stack-kube-state-metrics', url: 'http://kube-stack-kube-state-metrics.monitoring.svc.cluster.local:8080/metrics'],
                        [namespace: 'zabbix', kind: 'deploy', name: 'zabbix-server', url: ''],
                        [namespace: 'zabbix', kind: 'deploy', name: 'zabbix-web', url: 'http://zabbix-web.zabbix.svc.cluster.local:8080/']
                    ])
                }
            }
        }

        stage('4.8 编排分析与 BI 探针') {
            steps {
                script {
                    V10.probeV10ServiceGroup('workflow-analytics', params.V10_RUN_PLATFORM_PROBES, params.V10_STRICT_SERVICE_READY, params.V10_SERVICE_PROBE_TIMEOUT, [
                        [namespace: 'data-infra', kind: 'deploy', name: 'airflow-api-server', url: 'http://airflow-api-server.data-infra.svc.cluster.local:8080/health'],
                        [namespace: 'data-infra', kind: 'deploy', name: 'airflow-scheduler', url: ''],
                        [namespace: 'data-infra', kind: 'statefulset', name: 'airflow-triggerer', url: ''],
                        [namespace: 'data-infra', kind: 'deploy', name: 'trino-coordinator', url: 'http://trino.data-infra.svc.cluster.local:8080/v1/info'],
                        [namespace: 'data-infra', kind: 'deploy', name: 'trino-worker', url: ''],
                        [namespace: 'data-infra', kind: 'deploy', name: 'superset', url: 'http://superset.data-infra.svc.cluster.local:8088/health']
                    ])
                }
            }
        }

        stage('4.9 Kubernetes 基础能力探针') {
            steps {
                script {
                    V10.probeV10ServiceGroup('kubernetes-control-plane', params.V10_RUN_PLATFORM_PROBES, params.V10_STRICT_SERVICE_READY, params.V10_SERVICE_PROBE_TIMEOUT, [
                        [namespace: 'kube-system', kind: 'deploy', name: 'coredns', url: ''],
                        [namespace: 'kube-system', kind: 'deploy', name: 'metrics-server', url: ''],
                        [namespace: 'kube-system', kind: 'deploy', name: 'local-path-provisioner', url: ''],
                        [namespace: 'kube-system', kind: 'deploy', name: 'traefik', url: ''],
                        [namespace: 'ns-openclaw', kind: 'deploy', name: 'openclaw-controller', url: 'http://openclaw-controller-svc.ns-openclaw.svc.cluster.local:8080/']
                    ])
                }
            }
        }

        stage('4.10 资源画像与日志样本') {
            steps {
                script {
                    V10.collectV10RuntimeSamples(params.V10_INCLUDE_RESOURCE_PROFILE, params.V10_INCLUDE_POD_LOG_SAMPLE)
                }
            }
        }

        stage('4.11 证据汇总与失败门禁') {
            steps {
                script {
                    V10.summarizeV10ServiceProbes(params.V10_STRICT_SERVICE_READY)
                }
            }
        }

        stage('5. Grafana/Kibana 图表素材校验') {
            steps {
                sh '''
                    set -eux
                    test -s reports/v10-platform-services.json
                    test -s reports/v10-observability.ndjson
                    test -s reports/v10-prometheus-metrics.prom
                    test -s reports/v10-grafana-dashboard.json
                    test -s reports/v10-kibana-dashboard.ndjson
                    node -e "JSON.parse(require('fs').readFileSync('reports/v10-platform-services.json','utf8'))"
                    node -e "JSON.parse(require('fs').readFileSync('reports/v10-grafana-dashboard.json','utf8'))"
                    head -5 reports/v10-observability.ndjson
                    curl -fsS --max-time 8 ${PROMETHEUS_URL}/-/ready >/dev/null || true
                    curl -fsS --max-time 8 ${GRAFANA_URL}/api/health >/dev/null || true
                    curl -fsS --max-time 8 ${KIBANA_URL}/api/status >/dev/null || true
                '''
            }
        }

        stage('5.1 观测资产导入演练') {
            steps {
                script {
                    V10.rehearseV10ObservabilityImport(params.V10_IMPORT_OBSERVABILITY_ASSETS, params.V10_GRAFANA_DASHBOARD_TITLE, params.V10_KIBANA_INDEX_PREFIX)
                }
            }
        }

        stage('5.2 钉钉通知恢复演练') {
            steps {
                script {
                    V10.rehearseV10DingTalkNotification(params.V10_NOTIFY_DINGTALK)
                }
            }
        }

        stage('5.3 Prometheus 规则素材生成') {
            steps {
                script {
                    V10.generateV10PrometheusRulePreview(params.V10_KIBANA_INDEX_PREFIX)
                }
            }
        }

        stage('5.4 Grafana Dashboard 深度校验') {
            steps {
                script {
                    V10.lintV10GrafanaDashboard(params.V10_GRAFANA_DASHBOARD_TITLE)
                }
            }
        }

        stage('5.5 Kibana Saved Object 深度校验') {
            steps {
                script {
                    V10.lintV10KibanaSavedObjects(params.V10_KIBANA_INDEX_PREFIX)
                }
            }
        }

        stage('5.6 Jenkins 日志链路证据') {
            steps {
                script {
                    V10.writeV10LogRoutingEvidence()
                }
            }
        }

        stage('5.7 Zabbix 展示素材证据') {
            steps {
                script {
                    V10.writeV10ZabbixEvidence()
                }
            }
        }

        stage('5.8 Cloudflare 发布合约') {
            steps {
                script {
                    V10.writeV10CloudflareContract(params.V10_PORTAL_NAMESPACE, params.V10_PORTAL_NODEPORT, params.CLOUDFLARE_PUBLIC_HOSTNAME)
                }
            }
        }

        stage('6. Cloudflare-ready 成果门户') {
            steps {
                script {
                    if (params.V10_PUBLISH_PORTAL) {
                        def portalImage = "127.0.0.1:30050/hello-app-v10-portal:${env.GIT_COMMIT_ID}"
                        V10.publishV10EvidencePortal(params.V10_PORTAL_NAMESPACE, portalImage, params.V10_PORTAL_NODEPORT, params.CLOUDFLARE_PUBLIC_HOSTNAME)
                        V10.writeCloudflareTunnelTemplateV10(params.V10_PORTAL_NAMESPACE, params.CLOUDFLARE_PUBLIC_HOSTNAME, params.CLOUDFLARE_TUNNEL_SECRET)
                    } else {
                        sh "echo 'V10_PUBLISH_PORTAL=false' > reports/v10-portal-publish.log"
                    }
                }
            }
        }

        stage('6.1 Cloudflare 真实配置门禁') {
            steps {
                sh '''
                    set -eu
                    mkdir -p reports/cloudflare
                    CF_REQUIRED="${V10_REQUIRE_CLOUDFLARE_PUBLICATION:-false}"
                    [ "${CF_REQUIRED}" = "true" ] || CF_REQUIRED=false
                    CF_HOST="${CLOUDFLARE_PUBLIC_HOSTNAME:-}"
                    CF_NAMESPACE="${V10_PORTAL_NAMESPACE:-ns-apps}"
                    CF_SECRET="${CLOUDFLARE_TUNNEL_SECRET:-cloudflare-v10-tunnel-token}"
                    CF_IMAGE="${CLOUDFLARE_TUNNEL_IMAGE:-127.0.0.1:30050/library/cloudflared:latest}"
                    CF_NODEPORT="${V10_PORTAL_NODEPORT:-30087}"
                    HOST_CONFIGURED=false
                    SECRET_EXISTS=false
                    IMAGE_PRESENT=false
                    PUBLIC_REACHABLE=false
                    INTERNAL_PORTAL_REACHABLE=false
                    [ -n "${CF_HOST}" ] && HOST_CONFIGURED=true
                    kubectl -n "${CF_NAMESPACE}" get secret "${CF_SECRET}" >/dev/null 2>&1 && SECRET_EXISTS=true
                    docker image inspect "${CF_IMAGE}" >/dev/null 2>&1 && IMAGE_PRESENT=true || true
                    if curl -fsS --max-time 10 "http://hello-app-v10-portal.${CF_NAMESPACE}.svc.cluster.local/" | grep -q 'Jenkins V10 Platform Evidence'; then
                      INTERNAL_PORTAL_REACHABLE=true
                    fi
                    if [ -n "${CF_HOST}" ] && curl -fsS --max-time 20 "https://${CF_HOST}/" | grep -q 'Jenkins V10 Platform Evidence'; then
                      PUBLIC_REACHABLE=true
                    else
                      echo "Cloudflare public curl from Jenkins pod was not reachable; keeping this as evidence because cluster egress/hairpin can differ from external browser access." > reports/cloudflare/public-curl-warning.txt
                    fi
                    cat > reports/cloudflare/publication-gate.json <<EOF2
{
  "required": ${CF_REQUIRED},
  "hostname": "${CF_HOST}",
  "hostname_configured": ${HOST_CONFIGURED},
  "public_reachable": ${PUBLIC_REACHABLE},
  "internal_portal_reachable": ${INTERNAL_PORTAL_REACHABLE},
  "secret": "${CF_SECRET}",
  "secret_exists": ${SECRET_EXISTS},
  "image": "${CF_IMAGE}",
  "image_present_on_jenkins_node": ${IMAGE_PRESENT},
  "internal_portal": "http://192.168.1.58:${CF_NODEPORT}/"
}
EOF2
                    cat reports/cloudflare/publication-gate.json
                    if [ "${CF_REQUIRED}" = "true" ]; then
                      [ "${HOST_CONFIGURED}" = "true" ] || { echo "Cloudflare required but CLOUDFLARE_PUBLIC_HOSTNAME is empty."; exit 1; }
                      [ "${INTERNAL_PORTAL_REACHABLE}" = "true" ] || { echo "Cloudflare required but internal v10 portal is not reachable."; exit 1; }
                      if [ "${PUBLIC_REACHABLE}" != "true" ] && [ "${SECRET_EXISTS}" != "true" ]; then
                        echo "Cloudflare hostname is configured and internal portal is reachable; Kubernetes fallback secret is absent, so this run will use the existing host-level tunnel route."
                      elif [ "${PUBLIC_REACHABLE}" != "true" ]; then
                        echo "Cloudflare hostname is configured and fallback secret exists; public curl from Jenkins pod will be retried in publish stage."
                      else
                        echo "Cloudflare public hostname is reachable from Jenkins pod."
                      fi
                    fi
                '''
            }
        }
        stage('6.2 Cloudflare Tunnel Manifest 渲染') {
            steps {
                sh '''
                    set -eu
                    mkdir -p reports/cloudflare
                    CF_NAMESPACE="${V10_PORTAL_NAMESPACE:-ns-apps}"
                    CF_SECRET="${CLOUDFLARE_TUNNEL_SECRET:-cloudflare-v10-tunnel-token}"
                    CF_IMAGE="${CLOUDFLARE_TUNNEL_IMAGE:-127.0.0.1:30050/library/cloudflared:latest}"
                    cat > reports/cloudflare/v10-cloudflared-deployment.yaml <<EOF2
apiVersion: apps/v1
kind: Deployment
metadata:
  name: hello-app-v10-cloudflared
  namespace: ${CF_NAMESPACE}
  labels:
    app: hello-app-v10-cloudflared
    pipeline-version: v10
spec:
  replicas: 1
  selector:
    matchLabels:
      app: hello-app-v10-cloudflared
  template:
    metadata:
      labels:
        app: hello-app-v10-cloudflared
        pipeline-version: v10
    spec:
      containers:
      - name: cloudflared
        image: ${CF_IMAGE}
        imagePullPolicy: IfNotPresent
        args:
        - tunnel
        - --no-autoupdate
        - run
        - --token
        - \$(CLOUDFLARE_TUNNEL_TOKEN)
        env:
        - name: CLOUDFLARE_TUNNEL_TOKEN
          valueFrom:
            secretKeyRef:
              name: ${CF_SECRET}
              key: token
        resources:
          requests:
            cpu: 10m
            memory: 32Mi
          limits:
            memory: 128Mi
EOF2
                    kubectl apply --dry-run=client -f reports/cloudflare/v10-cloudflared-deployment.yaml >/dev/null
                    cat reports/cloudflare/v10-cloudflared-deployment.yaml
                '''
            }
        }

        stage('6.3 Cloudflare Tunnel 发布与公网验证') {
            steps {
                sh '''
                    set -eu
                    mkdir -p reports/cloudflare
                    CF_REQUIRED="${V10_REQUIRE_CLOUDFLARE_PUBLICATION:-false}"
                    CF_HOST="${CLOUDFLARE_PUBLIC_HOSTNAME:-}"
                    CF_NAMESPACE="${V10_PORTAL_NAMESPACE:-ns-apps}"
                    if [ "${CF_REQUIRED}" != "true" ]; then
                      echo "Cloudflare publication not required for this run." | tee reports/cloudflare/publication-result.txt
                      exit 0
                    fi
                    if [ -n "${CF_HOST}" ] && curl -fsS --max-time 30 "https://${CF_HOST}/" | grep -q 'Jenkins V10 Platform Evidence'; then
                      printf 'cloudflare_public_url=https://%s/\\nmode=existing-tunnel-route\\n' "${CF_HOST}" | tee reports/cloudflare/publication-result.txt
                      exit 0
                    fi
                    if curl -fsS --max-time 10 "http://hello-app-v10-portal.${CF_NAMESPACE}.svc.cluster.local/" | grep -q 'Jenkins V10 Platform Evidence'; then
                      printf 'cloudflare_public_url=https://%s/\\nmode=existing-host-tunnel-route-unverified-from-jenkins-pod\\nreason=jenkins-pod-egress-or-hairpin-timeout\\n' "${CF_HOST}" | tee reports/cloudflare/publication-result.txt
                      exit 0
                    fi
                    if ! kubectl -n "${CF_NAMESPACE}" get secret "${CLOUDFLARE_TUNNEL_SECRET:-cloudflare-v10-tunnel-token}" >/dev/null 2>&1; then
                      echo "Cloudflare public hostname https://${CF_HOST}/ is not reachable and no Kubernetes tunnel secret exists for fallback deployment."
                      exit 1
                    fi
                    kubectl apply -f reports/cloudflare/v10-cloudflared-deployment.yaml
                    kubectl rollout status deployment/hello-app-v10-cloudflared -n "${CF_NAMESPACE}" --timeout=180s
                    curl -fsS --max-time 30 "https://${CF_HOST}/" | grep -q 'Jenkins V10 Platform Evidence'
                    printf 'cloudflare_public_url=https://%s/\\n' "${CF_HOST}" | tee reports/cloudflare/publication-result.txt
                '''
            }
        }

        stage('7. 成果验证') {
            steps {
                sh '''
                    set -eux
                    curl -fsS --max-time 10 http://hello-app-v10-portal.${V10_PORTAL_NAMESPACE}.svc.cluster.local/ | grep -q 'Jenkins V10 Platform Evidence'
                    curl -fsS --max-time 5 http://192.168.1.58:${V10_PORTAL_NODEPORT}/ >/dev/null || true
                    kubectl get deploy,svc -n ${V10_PORTAL_NAMESPACE} -l app=hello-app-v10-portal -o wide | tee reports/v10-portal-k8s.txt
                    if [ "${RUN_SMOKE_TEST:-true}" = "true" ]; then
                      curl -fsS --max-time 10 "${APP_HEALTH_URL}" >/dev/null || echo "business smoke recorded as warning"
                    fi
                '''
            }
        }

        stage('8. 构建总结') {
            steps {
                sh '''
                    set -eux
                    cat > meta/build-summary.txt <<EOF2
Jenkins V10 platform evidence pipeline finished.
Build: ${BUILD_NUMBER}
Commit: ${GIT_COMMIT_ID}
Portal: http://192.168.1.58:${V10_PORTAL_NODEPORT}/
Artifacts: reports/v10-platform-services.json, reports/v10-observability.ndjson, reports/v10-prometheus-metrics.prom, reports/v10-grafana-dashboard.json, reports/v10-kibana-dashboard.ndjson
EOF2
                    cat meta/build-summary.txt
                '''
            }
        }

        stage('9.1 破坏性命令审计') {
            steps {
                script {
                    V10.auditV10DestructiveCommands()
                }
            }
        }

        stage('9.2 产物完整性门禁') {
            steps {
                script {
                    V10.validateV10ArtifactCompleteness()
                }
            }
        }

        stage('9.3 Stage 结果清单') {
            steps {
                script {
                    V10.writeV10StageManifest()
                }
            }
        }

        stage('10. Stage 复杂度与反凑行审计') {
            steps {
                sh '''
                    set -eu
                    mkdir -p reports/v10-complexity
                    grep -c "^[[:space:]]*stage(" Jenkinsfile-expert-v9 > reports/v10-complexity/v9-stage-count.txt
                    grep -c "^[[:space:]]*stage(" Jenkinsfile-expert-v10 > reports/v10-complexity/v10-stage-count.txt
                    wc -l Jenkinsfile-expert-v9 Jenkinsfile-expert-v10 > reports/v10-complexity/line-count.txt
                    BAD_TOKEN='V10_INLINE_ACCEPTANCE_''LEDGER'
                    if grep -q "$BAD_TOKEN" Jenkinsfile-expert-v10; then
                      echo "Filler ledger is forbidden in v10." >&2
                      exit 1
                    fi
                    V9=$(cat reports/v10-complexity/v9-stage-count.txt)
                    V10=$(cat reports/v10-complexity/v10-stage-count.txt)
                    [ "$V10" -ge "$V9" ] || { echo "v10 stage count $V10 is lower than v9 $V9"; exit 1; }
                    paste -d' ' reports/v10-complexity/v9-stage-count.txt reports/v10-complexity/v10-stage-count.txt | awk '{print "v9_stages="$1" v10_stages="$2}' | tee reports/v10-complexity/stage-parity.txt
                '''
            }
        }

        stage('11. Jenkins 能力与插件核验') {
            steps {
                sh '''
                    set -eu
                    mkdir -p reports/v10-jenkins-capability
                    test -d /var/jenkins_home/plugins
                    ls /var/jenkins_home/plugins | sort > reports/v10-jenkins-capability/plugins.txt
                    for p in workflow-job workflow-cps pipeline-stage-view git gitlab-plugin credentials docker-workflow; do
                      grep -q "^${p}\\." reports/v10-jenkins-capability/plugins.txt || echo "plugin_missing_or_bundled=${p}" >> reports/v10-jenkins-capability/plugin-gaps.txt
                    done
                    test -f Jenkinsfile-router
                    grep -q 'Jenkinsfile-expert-v10' Jenkinsfile-router
                    tail -20 reports/v10-jenkins-capability/plugin-gaps.txt 2>/dev/null || true
                '''
            }
        }

        stage('12. GitLab 源码与版本契约核验') {
            steps {
                sh '''
                    set -eu
                    mkdir -p reports/v10-git-contract
                    git remote -v | tee reports/v10-git-contract/remotes.txt
                    git log --oneline -5 > reports/v10-git-contract/recent-commits.txt
                    for f in Jenkinsfile Jenkinsfile-expert-v9 Jenkinsfile-expert-v10 Jenkinsfile-router Dockerfile pom.xml; do
                      test -s "$f"
                      sha256sum "$f" >> reports/v10-git-contract/source-digests.sha256
                    done
                    grep -q 'Jenkinsfile-expert-v10' Jenkinsfile-router
                    cat reports/v10-git-contract/source-digests.sha256
                '''
            }
        }

        stage('13. Dockerfile 与本地镜像恢复审计') {
            steps {
                sh '''
                    set -eu
                    mkdir -p reports/v10-image-recovery
                    docker images --format '{{.Repository}}:{{.Tag}} {{.ID}} {{.Size}}' | sort > reports/v10-image-recovery/docker-images.txt
                    REGISTRY_OK=false
                    for endpoint in \
                      http://local-registry.ns-devops.svc.cluster.local:5000/v2/ \
                      http://10.43.243.46:5000/v2/ \
                      http://192.168.1.58:30050/v2/ \
                      http://127.0.0.1:30050/v2/
                    do
                      if curl -fsS --max-time 10 "$endpoint" >/dev/null; then
                        echo "registry_endpoint_ok=$endpoint" | tee reports/v10-image-recovery/registry-endpoint.txt
                        REGISTRY_OK=true
                        break
                      fi
                    done
                    [ "$REGISTRY_OK" = "true" ] || { echo "No registry endpoint reachable from Jenkins workspace."; exit 1; }
                    grep -nE '^FROM|127.0.0.1:30050|harbor.devops.local' Dockerfile Jenkinsfile-expert-v10 jenkins-v10-evidence.groovy > reports/v10-image-recovery/local-image-references.txt || true
                    test -s reports/v10-image-recovery/docker-images.txt
                    head -30 reports/v10-image-recovery/docker-images.txt
                '''
            }
        }

        stage('14. ArgoCD 配置可渲染门禁') {
            steps {
                sh '''
                    set -eu
                    mkdir -p reports/v10-argocd
                    kubectl -n argocd get deploy,svc,pod -o wide > reports/v10-argocd/runtime.txt
                    find argocd k8s -maxdepth 3 -type f 2>/dev/null | sort > reports/v10-argocd/manifest-files.txt || true
                    if [ -s reports/v10-portal/k8s.yaml ]; then
                      kubectl apply --dry-run=server -f reports/v10-portal/k8s.yaml >/dev/null
                    fi
                    cat reports/v10-argocd/runtime.txt
                '''
            }
        }

        stage('15. Kubernetes 工作负载硬门禁') {
            steps {
                sh '''
                    set -eu
                    mkdir -p reports/v10-k8s-hard-gate
                    kubectl get nodes -o wide > reports/v10-k8s-hard-gate/nodes.txt
                    kubectl get pods -A -o wide > reports/v10-k8s-hard-gate/pods.txt
                    kubectl get pods -A --no-headers | awk '$4!="Running" && $4!="Completed" {print}' > reports/v10-k8s-hard-gate/non-running-pods.txt
                    if [ -s reports/v10-k8s-hard-gate/non-running-pods.txt ]; then
                      cat reports/v10-k8s-hard-gate/non-running-pods.txt
                      exit 1
                    fi
                    kubectl top nodes > reports/v10-k8s-hard-gate/node-usage.txt || true
                    cat reports/v10-k8s-hard-gate/node-usage.txt || true
                '''
            }
        }

        stage('16. 日志链路端到端探针') {
            steps {
                sh '''
                    set -eu
                    mkdir -p reports/v10-log-e2e
                    MARKER="v10-log-e2e-${BUILD_NUMBER}-${GIT_COMMIT_ID}"
                    echo "$MARKER" | tee reports/v10-log-e2e/marker.txt
                    kubectl -n ns-devops logs deploy/jenkins --tail=80 > reports/v10-log-e2e/jenkins-tail.log || true
                    curl -fsS --max-time 10 http://elasticsearch.default.svc.cluster.local:9200/_cluster/health > reports/v10-log-e2e/elasticsearch-health.json
                    curl -fsS --max-time 10 http://kibana-service.default.svc.cluster.local:5601/api/status -H 'kbn-xsrf: true' > reports/v10-log-e2e/kibana-status.json
                    test -s reports/v10-log-e2e/elasticsearch-health.json
                    test -s reports/v10-log-e2e/kibana-status.json
                '''
            }
        }

        stage('17. 图表素材可导入门禁') {
            steps {
                sh '''
                    set -eu
                    mkdir -p reports/v10-dashboard-import-gate
                    node -e "const fs=require('fs'); const d=JSON.parse(fs.readFileSync('reports/v10-grafana-dashboard.json','utf8')); if(!Array.isArray(d.panels)||d.panels.length<4) process.exit(1); console.log('grafana_panels='+d.panels.length)" | tee reports/v10-dashboard-import-gate/grafana.txt
                    node -e "const fs=require('fs'); const rows=fs.readFileSync('reports/v10-kibana-dashboard.ndjson','utf8').trim().split(/\\n+/); if(rows.length<1) process.exit(1); rows.forEach(x=>JSON.parse(x)); console.log('kibana_objects='+rows.length)" | tee reports/v10-dashboard-import-gate/kibana.txt
                    grep -q 'cicd_v10_service_probe_ok' reports/v10-prometheus-metrics.prom
                    grep -q 'jenkins-v10-platform' reports/v10-kibana-dashboard.ndjson
                '''
            }
        }

        stage('18. 真实发布结论与回滚证据包') {
            steps {
                sh '''
                    set -eu
                    mkdir -p reports/v10-release-verdict
                    PUBLIC_STATUS="not_configured"
                    if [ -s reports/cloudflare/publication-result.txt ]; then
                      PUBLIC_STATUS="$(cat reports/cloudflare/publication-result.txt | tr '\\n' ' ')"
                    elif [ "${V10_REQUIRE_CLOUDFLARE_PUBLICATION:-false}" = "true" ]; then
                      PUBLIC_STATUS="required_but_not_published"
                    fi
                    CF_HOST="${CLOUDFLARE_PUBLIC_HOSTNAME:-}"
                    CF_NODEPORT="${V10_PORTAL_NODEPORT:-30087}"
                    cat > reports/v10-release-verdict/verdict.json <<EOF2
{
  "pipeline": "Jenkinsfile-expert-v10",
  "build": "${BUILD_NUMBER}",
  "commit": "${GIT_COMMIT_ID}",
  "internal_portal": "http://192.168.1.58:${CF_NODEPORT}/",
  "cloudflare_hostname": "${CF_HOST}",
  "cloudflare_publication": "${PUBLIC_STATUS}",
  "rollback_scope": "v10 portal/cloudflared resources only; no PVC or backup deletion"
}
EOF2
                    kubectl -n "${V10_PORTAL_NAMESPACE:-ns-apps}" get deploy,svc -l pipeline-version=v10 -o yaml > reports/v10-release-verdict/v10-k8s-resources.yaml || true
                    cat reports/v10-release-verdict/verdict.json
                '''
            }
        }
    }

    post {
        success { echo "V10 SUCCESS: http://192.168.1.58:${params.V10_PORTAL_NODEPORT}/" }
        failure { echo 'V10 FAILURE: check reports and console log.' }
        always {
            archiveArtifacts allowEmptyArchive: true, artifacts: 'meta/**,reports/**', fingerprint: true
            cleanWs(deleteDirs: true, disableDeferredWipeout: true, notFailBuild: true)
        }
    }
}
