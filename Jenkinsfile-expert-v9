                            if (params.DRY_RUN) {
                                sh "mkdir -p reports && echo '{\"status\":\"safe-no-op\",\"DRY_RUN\":\"true\"}' > reports/sbom.cyclonedx.json"
                            } else {
                                sh '''
                                    set -eux; mkdir -p reports
                                    if command -v syft >/dev/null 2>&1; then
                                      syft ${IMAGE_NAME} -o cyclonedx-json > reports/sbom.cyclonedx.json
                                      echo "✅ SBOM（Syft）"
                                    else
                                      docker run --rm --network host \
                                        -v /var/run/docker.sock:/var/run/docker.sock \
                                        aquasec/trivy:${TRIVY_VER} image --format cyclonedx \
                                        ${IMAGE_NAME} > reports/sbom.cyclonedx.json || true
                                      echo "✅ SBOM（Trivy 降级）"
                                    fi
                                '''
                            }
                        }
                    }
                }

                stage('6.3 镜像签名 (Cosign)') {
                    steps {
                        script {
                            if (!params.SIGN_IMAGE || params.DRY_RUN) {
                                sh "mkdir -p reports && echo 'Cosign safe no-op: SIGN_IMAGE=${params.SIGN_IMAGE}, DRY_RUN=${params.DRY_RUN}' > reports/cosign.log"
                            } else {
                                try {
                                withCredentials([
                                    string(credentialsId: 'cosign-private-key',  variable: 'COSIGN_KEY'),
                                    string(credentialsId: 'cosign-key-password', variable: 'COSIGN_PASSWORD')
                                ]) {
                                    sh '''
                                        set -eux
                                        if command -v cosign >/dev/null 2>&1; then
                                          echo "${COSIGN_KEY}" | base64 -d > /tmp/cosign.key
