// ║  解决 MethodTooLargeException：辅助函数移入独立文件，单独 CPS 编译         ║
// ╚══════════════════════════════════════════════════════════════════════════╝

import groovy.json.JsonOutput   // Stage 0 build-info.json 需要

def H   // 辅助函数对象 – 在 Stage 0 checkout 之后 load('jenkins-v9-helpers.groovy')



// ════════════════════════════════════════════════════════════════════════════
//  Pipeline 主体
// ════════════════════════════════════════════════════════════════════════════
pipeline {
    agent any

    triggers {
        gitlab(
            triggerOnPush: true,
            triggerOnMergeRequest: true,
            branchFilterType: 'NameBasedFilter',
            includeBranchesSpec: 'main'
        )
    }

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 180, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '20'))
        // parallelsAlwaysFailFast()  ← 已关闭：避免单个并行分支失败杀死全流水线
    }

    parameters {
        choice(name: 'PIPELINE_VERSION', choices: ['Jenkinsfile-expert-v9', 'Jenkinsfile-v8-jkvideo', 'Jenkinsfile-expert-v8', 'Jenkinsfile-expert-v7', 'Jenkinsfile-expert-v6', 'Jenkinsfile-expert-v5', 'Jenkinsfile-expert-v4', 'Jenkinsfile-expert-v3', 'Jenkinsfile-expert-v2', 'Jenkinsfile'], description: 'Select Jenkinsfile version, newest first.')
        choice(name: 'DEPLOY_ENV', choices: ['dev', 'test', 'prod'], description: '目标部署环境')
        booleanParam(name: 'SKIP_SECURITY_SCAN', defaultValue: false, description: '跳过安全扫描')
        booleanParam(name: 'RUN_UNIT_TESTS',     defaultValue: true,  description: '执行 JUnit + JaCoCo')
        booleanParam(name: 'RUN_SMOKE_TEST',     defaultValue: true,  description: '部署后烟雾测试')
        booleanParam(name: 'DRY_RUN',            defaultValue: true,  description: 'DRY RUN 模式')
        choice(name: 'FLINK_RUN_MODE', choices: ['skip', 'run'], description: 'Flink 任务模式')
        string(name: 'K8S_NAMESPACE',  defaultValue: 'ns-apps',  description: '主应用命名空间')
        string(name: 'APP_HEALTH_URL', defaultValue: '', description: '健康检查地址；留空时自动发现 Kubernetes Service')

        booleanParam(name: 'BUILD_JKVIDEO',    defaultValue: true,  description: '构建 JKVideo')
        string(name: 'JKVIDEO_REPO_URL', defaultValue: 'http://gitlab-service/root/JKVideo.git', description: 'JKVideo 仓库')
        string(name: 'JKVIDEO_BRANCH',   defaultValue: 'main', description: 'JKVideo 分支')
        choice(name: 'JKVIDEO_PLATFORMS', choices: ['web', 'android+web', 'android'], description: 'JKVideo 平台')
        booleanParam(name: 'JKVIDEO_RUN_JEST', defaultValue: true, description: 'JKVideo Jest 测试')

        choice(name: 'DEPLOY_STRATEGY', choices: ['rolling', 'blue-green', 'canary'], description: '[v9] 部署策略')
        string(name: 'CANARY_WEIGHT',   defaultValue: '20',  description: '[v9] 金丝雀权重 %')
        booleanParam(name: 'SKIP_PERF_TEST',      defaultValue: true,  description: '[v9] 跳过 k6')
        booleanParam(name: 'SKIP_DB_MIGRATION',   defaultValue: true,  description: '[v9] 跳过 Flyway')
        booleanParam(name: 'SIGN_IMAGE',           defaultValue: false, description: '[v9] Cosign 签名')
        booleanParam(name: 'UPLOAD_TO_MINIO',      defaultValue: false, description: '[v9] MinIO 归档')
        booleanParam(name: 'TRIGGER_AIRFLOW_DAG',  defaultValue: false, description: '[v9] 触发 Airflow')
        booleanParam(name: 'CHECK_TRINO_QUERY',    defaultValue: false, description: '[v9] Trino 验证')
        booleanParam(name: 'VERIFY_ARGOCD_SYNC',   defaultValue: false, description: '[v9] ArgoCD 同步验证')
        string(name: 'PERF_BASELINE_RPS', defaultValue: '100', description: '[v9] k6 最低 RPS')
        string(name: 'ROLLBACK_TIMEOUT',  defaultValue: '30',  description: '[v9] 回滚等待秒数')
    }

    environment {
        SCRIPT_NAME      = 'Jenkinsfile-expert-v9'
        APP_NAME         = 'hello-app'
        REGISTRY         = '127.0.0.1:30050'
        CONFIG_REPO_URL  = 'http://gitlab-service/root/hello-app-config.git'
        TRIVY_VER        = '0.68.2'
        MAVEN_IMAGE      = 'maven:3-eclipse-temurin-17'
        SONAR_URL        = 'http://192.168.1.58:30085'
        SONAR_TOKEN      = credentials('sonar-token')
        TRIVY_DB_REPO    = '10.43.243.46:5000/aquasecurity/trivy-db:2'
        MAVEN_CACHE      = '/root/.m2'
        NPM_CACHE        = '/root/.npm'
        GITOPS_CREDENTIALS = 'gitlab-root-auth'
        JKVIDEO_APP_NAME   = 'jkvideo'
        KAFKA_NS    = 'ns-bigdata'
        KAFKA_POD   = 'kafka-0'
        KAFKA_PORT  = '9092'
        FLINK_URL   = 'http://192.168.1.58:30081'
        ES_URL         = 'http://10.43.236.105:9200'
        PROMETHEUS_URL = 'http://10.43.111.46:9090'
        GRAFANA_URL    = 'http://192.168.1.58:30084'
        LOKI_URL       = 'http://10.43.7.197:3100'
        KIBANA_URL     = 'http://192.168.1.58:30061'
        JAEGER_URL     = 'http://10.43.200.190:16686'
        ZABBIX_URL     = 'http://192.168.1.58:30086'
        MINIO_HOST     = 'minio.data-infra.svc.cluster.local'
        MINIO_PORT     = '9000'
        MINIO_BUCKET   = 'devops-artifacts'
        MINIO_ACCESS   = 'admin'
        MINIO_SECRET   = 'Admin@123456'
        AIRFLOW_URL    = 'http://10.43.35.53:8080'
        TRINO_URL      = 'http://10.43.40.171:8080'
        ARGOCD_URL     = 'http://10.43.243.153'
        MYSQL_IP       = '192.168.1.58:30306'
        MONGO_IP       = '192.168.1.58'
        PG_IP          = '192.168.1.58:30532'
        KAFKA_HOST     = ''
    }

    stages {

        stage('清理环境') {
            steps { deleteDir() }
        }

        stage('0. 初始化上下文') {
            steps {
                checkout scm
                script {
                    // 加载辅助函数库（独立 CPS 编译单元）
                    H = load('jenkins-v9-helpers.groovy')
                    sh 'mkdir -p meta reports'
                    env.GIT_COMMIT_ID   = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    env.GIT_BRANCH_NAME = sh(script: 'git rev-parse --abbrev-ref HEAD', returnStdout: true).trim()
                    env.GIT_COMMIT_MSG  = sh(script: 'git log -1 --pretty=%s', returnStdout: true).trim()
                    env.GIT_AUTHOR      = sh(script: 'git log -1 --pretty=%an', returnStdout: true).trim()

                    // ── 完全用 Shell 计算 SEMVER，避免 @NonCPS List 跨 CPS 边界序列化失败 ──
                    def lastTag = sh(
                        script: "git tag --list --sort=-v:refname | grep -E '^v[0-9]+\\.[0-9]+\\.[0-9]+\$' | head -1 2>/dev/null || true",
                        returnStdout: true
                    ).trim()
                    if (!lastTag) lastTag = 'v0.0.0'

                    def semverRaw = sh(
                        script: """
                            LAST_TAG='${lastTag}'
                            MAJ=\$(echo "\$LAST_TAG" | sed 's/^v//' | cut -d. -f1)
                            MIN=\$(echo "\$LAST_TAG" | cut -d. -f2)
                            PAT=\$(echo "\$LAST_TAG" | cut -d. -f3)
                            MAJ=\${MAJ:-0}; MIN=\${MIN:-0}; PAT=\${PAT:-0}
                            MSG=\$(git log -1 --pretty=%s 2>/dev/null || true)
                            if echo "\$MSG" | grep -qE 'BREAKING CHANGE|!:'; then
                                MAJ=\$((MAJ + 1)); MIN=0; PAT=0
                            elif echo "\$MSG" | grep -q '^feat'; then
                                MIN=\$((MIN + 1)); PAT=0
                            else
                                PAT=\$((PAT + 1))
                            fi
                            printf "%d.%d.%d" "\$MAJ" "\$MIN" "\$PAT"
                        """,
                        returnStdout: true
                    ).trim()
                    if (semverRaw) {
                        env.SEMVER = semverRaw
                    } else {
                        env.SEMVER = '0.0.1'
                    }
                    def msg = env.GIT_COMMIT_MSG ?: ''   // 必须保留：下方 currentBuild.description 使用
                    echo "✅ SEMVER = ${env.SEMVER}"
                    env.IMAGE_NAME        = "${env.REGISTRY}/${env.APP_NAME}:${env.SEMVER}"
                    env.JKVIDEO_WEB_IMAGE = "${env.REGISTRY}/${env.JKVIDEO_APP_NAME}-web:${env.GIT_COMMIT_ID}"

                    // 默认值（environment{} 块已移除，需在此初始化）
                    env.PREV_DEPLOY_REV   = '0'
                    env.PREV_SVC_SELECTOR = '{}'
                    env.DEPLOY_STARTED    = 'false'

                    if (!params.DRY_RUN) {
                        try {
                            env.PREV_DEPLOY_REV = sh(
                                script: "kubectl rollout history deployment/${env.APP_NAME} -n ${params.K8S_NAMESPACE} 2>/dev/null | awk 'NF && \$1~/^[0-9]+\$/{rev=\$1} END{print (rev?rev:0)}'",
                                returnStdout: true
                            ).trim()
                            env.PREV_SVC_SELECTOR = sh(
                                script: "kubectl get svc ${env.APP_NAME} -n ${params.K8S_NAMESPACE} -o jsonpath='{.spec.selector}' 2>/dev/null || echo '{}'",
                                returnStdout: true
                            ).trim()
                        } catch (ignored) { }
                    }

                    sh """
                        { echo "# ChangeLog — v${env.SEMVER}"; echo; echo "Baseline: ${lastTag}"; echo
                          git log ${lastTag == 'v0.0.0' ? '' : "${lastTag}..HEAD"} --pretty='- %h %s (%an)' --no-merges
                        } > reports/CHANGELOG.md
                    """
                    writeFile file: 'meta/build-info.json', text: JsonOutput.toJson([
                        script: env.SCRIPT_NAME, semver: env.SEMVER,
                        image: env.IMAGE_NAME,   jkvideo: env.JKVIDEO_WEB_IMAGE,
                        git_commit: env.GIT_COMMIT_ID, git_branch: env.GIT_BRANCH_NAME,
                        git_author: env.GIT_AUTHOR,    build: env.BUILD_NUMBER,
                        deploy_env: params.DEPLOY_ENV, strategy: params.DEPLOY_STRATEGY,
                        dry_run: params.DRY_RUN,       build_url: env.BUILD_URL
                    ])
                    currentBuild.displayName = "#${env.BUILD_NUMBER} v${env.SEMVER} [${params.DEPLOY_ENV}/${params.DEPLOY_STRATEGY}]"
                    currentBuild.description = "${env.GIT_AUTHOR} | ${msg.take(60)}"
                    sh 'cat meta/build-info.json'
                    H.notifyDingTalk('STARTED', "🚀 v${env.SEMVER} 启动 | ${params.DEPLOY_ENV} | ${params.DEPLOY_STRATEGY}")
                    stash name: 'workspace-src', includes: '**/*', excludes: '.git/**, target/**, config-repo/**', useDefaultExcludes: false
                }
            }
        }

        stage('1.5 拉取 JKVideo 源码') {
            steps {
                script {
                    if (!params.BUILD_JKVIDEO) {
                        echo "BUILD_JKVIDEO=false, JKVideo source checkout safely no-op."
                        sh "mkdir -p ${WORKSPACE}/jkvideo-src"
                    } else {
                        sh "mkdir -p ${WORKSPACE}/jkvideo-src"
                        dir("${WORKSPACE}/jkvideo-src") {
                            checkout([
                                $class: 'GitSCM',
                                branches: [[name: "*/${params.JKVIDEO_BRANCH}"]],
                                userRemoteConfigs: [[url: params.JKVIDEO_REPO_URL, credentialsId: env.GITOPS_CREDENTIALS]]
                            ])
                        }
                        stash name: 'jkvideo-src', includes: 'jkvideo-src/**/*', excludes: 'jkvideo-src/.git/**'
                        echo "✅ JKVideo 源码拉取完成"
                    }
                }
            }
        }

        stage('1. 执行前预检') {
            steps {
                sh '''
                    set -eux
                    test -f Dockerfile
                    docker version
                    kubectl version --client
                    git --version
                    python3 --version || echo "⚠️ python3 未安装（不影响流水线）"
                    
                    # 关键修改：防止 get nodes 卡住整个流水线
                    timeout 15 kubectl get nodes --no-headers -o wide || echo "⚠️ kubectl get nodes 超时，继续执行"
                    
                    free -h
                    command -v cosign || echo "⚠️ cosign 未安装"
                    command -v syft || echo "⚠️ syft 未安装"
                '''
            }
        }

        stage('2. 并行质量关卡') {
            parallel {

                stage('2.1 源码脱敏审计 (Trivy FS)') {
                    steps {
                        script {
                            if (params.SKIP_SECURITY_SCAN) {
                                sh "mkdir -p reports && echo 'SKIP_SECURITY_SCAN=true, Trivy FS no-op.' > reports/trivy-fs.txt"
                            } else {
                                dir('ws-2-1') {
                                    deleteDir(); unstash 'workspace-src'
                                    sh '''
                                        set -eux; mkdir -p reports
                                        docker rm -f temp-trivy-fs || true
                                        docker run -d --name temp-trivy-fs \
                                          --entrypoint /bin/sh -w /work \
                                          aquasec/trivy:${TRIVY_VER} -c 'sleep 3600'
                                        docker cp . temp-trivy-fs:/work
                                        docker exec temp-trivy-fs trivy fs /work --scanners secret --format table | tee reports/trivy-fs.txt
                                        docker rm -f temp-trivy-fs
                                    '''
                                }
                            }
                        }
                    }
                }

                stage('2.2 SonarQube + Quality Gate') {
                    steps {
                        script {
                            if (params.SKIP_SECURITY_SCAN) {
                                sh "mkdir -p reports && echo 'SKIP_SECURITY_SCAN=true, SonarQube no-op.' > reports/sonar.log"
                            } else {
                                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                                    dir('ws-2-2') {
                                        deleteDir()
                                        unstash 'workspace-src'
                                        sh '''
                                            set -eux
                                            if [ -f pom.xml ]; then
                                                docker rm -f temp-sonar-scan 2>/dev/null || true
                                                docker run -d --name temp-sonar-scan --network host \
                                                    -v ${MAVEN_CACHE}:/root/.m2 -w /usr/src ${MAVEN_IMAGE} sleep 3600

                                                docker cp . temp-sonar-scan:/usr/src/

                                                docker exec temp-sonar-scan mvn -B -U compile sonar:sonar \
                                                    -Dsonar.host.url=${SONAR_URL} \
                                                    -Dsonar.token=${SONAR_TOKEN} \
                                                    -Dsonar.projectKey=${APP_NAME} \
                                                    -Dsonar.sources=. \
                                                    -Dsonar.exclusions=**/*.js,**/*.html \
                                                    -Dsonar.qualitygate.wait=false || true

                                                docker rm -f temp-sonar-scan || true
                                                echo "⚠️ SonarQube Quality Gate 未通过，已继续执行流水线"
                                            else
                                                echo "⚠️ 无 pom.xml，跳过 SonarQube"
                                            fi
                                        '''
                                    }
                                }
                            }
                        }
                    }
                }

                stage('2.3 单元测试 (JUnit + JaCoCo)') {
                    steps {
                        script {
                            if (!params.RUN_UNIT_TESTS) {
                                sh "mkdir -p reports && echo 'RUN_UNIT_TESTS=false, unit test no-op.' > reports/unit-test.log"
                            } else {
                                dir('ws-2-3') {
                                    deleteDir(); unstash 'workspace-src'
                                    sh '''
                                        set -eux
                                        if [ -f pom.xml ]; then
                                          docker rm -f temp-maven-test || true
                                          docker run -d --name temp-maven-test \
                                            -v ${MAVEN_CACHE}:/root/.m2 -w /usr/src ${MAVEN_IMAGE} sleep 3600
                                          docker cp . temp-maven-test:/usr/src/
                                          docker exec temp-maven-test mvn -B -U \
                                            org.jacoco:jacoco-maven-plugin:prepare-agent test \
                                            org.jacoco:jacoco-maven-plugin:report
                                          mkdir -p target
                                          docker cp temp-maven-test:/usr/src/target target || true
                                          docker rm -f temp-maven-test
                                        else
                                          echo "⚠️ 无 pom.xml，跳过单元测试"
                                        fi
                                    '''
                                }
                            }
                        }
                    }
                    post {
                        always {
                            script {
                                def hasJUnit = sh(script: "find ws-2-3/target -path '*/surefire-reports/*.xml' -print -quit 2>/dev/null | grep -q .", returnStatus: true) == 0
                                if (hasJUnit) {
                                    junit allowEmptyResults: true, testResults: 'ws-2-3/target/**/surefire-reports/*.xml'
                                } else {
                                    echo 'No JUnit report files found; tests produced no XML reports.'
                                }
                            }
                        }
                    }
                }

                stage('2.4 JKVideo Jest 单元测试') {
                    steps {
                        script {
                            if (!params.BUILD_JKVIDEO || !params.JKVIDEO_RUN_JEST) {
                                sh "mkdir -p reports/jkvideo-jest && echo 'JKVideo Jest disabled, safe no-op.' > reports/jkvideo-jest/jest.log"
                            } else {
                                dir('ws-2-4') {
                                    deleteDir(); unstash 'jkvideo-src'
                                    sh '''
                                        set -eux
                                        docker rm -f temp-jkvideo-jest || true
                                        docker run -d --name temp-jkvideo-jest \
                                          -v ${NPM_CACHE}:/root/.npm -w /app node:20-alpine sleep 3600
                                        docker cp jkvideo-src/. temp-jkvideo-jest:/app/
                                        docker exec temp-jkvideo-jest npm ci --prefer-offline --cache /root/.npm
                                        docker exec temp-jkvideo-jest npx tsc --noEmit || true
                                        docker exec temp-jkvideo-jest npm test -- \
                                          --config jest.config.js --coverage --ci \
                                          --passWithNoTests --forceExit \
                                          --reporters=default --reporters=jest-junit || true
                                        mkdir -p reports/jkvideo-jest
                                        docker cp temp-jkvideo-jest:/app/coverage/junit.xml reports/jkvideo-jest/ 2>/dev/null || true
                                        docker cp temp-jkvideo-jest:/app/coverage/lcov.info reports/jkvideo-jest/ 2>/dev/null || true
                                        docker rm -f temp-jkvideo-jest
                                    '''
                                }
                            }
                        }
                    }
                    post {
                        always {
                            script {
                                if (fileExists('ws-2-4/reports/jkvideo-jest/junit.xml')) {
                                    junit allowEmptyResults: true, testResults: 'ws-2-4/reports/jkvideo-jest/junit.xml'
                                } else {
                                    echo 'No JKVideo Jest JUnit report found; stage recorded safe no-op output.'
                                }
                            }
                        }
                    }
                }

                stage('2.5 数据库连通性预检') {
                    steps {
                        sh '''
                            set -eux
                            MYSQL_IP=$(kubectl get pod -n ns-data -l app=mysql -o jsonpath="{.items[0].status.podIP}" 2>/dev/null || echo "127.0.0.1")
                            MONGO_IP=$(kubectl get pod -n ns-data -l app.kubernetes.io/name=mongodb -o jsonpath="{.items[0].status.podIP}" 2>/dev/null || echo "")
                            PG_IP=$(kubectl get pod -n ns-data -l app=postgresql -o jsonpath="{.items[0].status.podIP}" 2>/dev/null || echo "127.0.0.1")
                            docker rm -f temp-db-check || true
                            docker run -d --name temp-db-check --network host alpine:3.20 sleep 120
                            docker exec temp-db-check sh -c "nc -z -w 5 ${MYSQL_IP} 3306  && echo SUCCESS:MySQL      || echo FAIL:MySQL不可达"
                            if [ -n "${MONGO_IP}" ]; then
                              docker exec temp-db-check sh -c "nc -z -w 5 ${MONGO_IP} 27017 && echo SUCCESS:MongoDB || echo FAIL:MongoDB不可达"
                            else
                              echo "INFO:MongoDB未部署，跳过连通性检查"
                            fi
                            docker exec temp-db-check sh -c "nc -z -w 5 ${PG_IP} 5432     && echo SUCCESS:PostgreSQL || echo FAIL:PostgreSQL不可达"
                            docker rm -f temp-db-check
                        '''
                    }
                }



                stage('2.6 依赖差异报告') {
                    steps {
                        dir('ws-2-6') {
                            deleteDir(); unstash 'workspace-src'
                            sh '''
                                set -eux; mkdir -p reports
                                if [ -f pom.xml ]; then
                                  docker rm -f temp-dep-diff || true
                                  docker run -d --name temp-dep-diff \
                                    -v ${MAVEN_CACHE}:/root/.m2 -w /usr/src ${MAVEN_IMAGE} sleep 120
                                  docker cp . temp-dep-diff:/usr/src/
                                  docker exec temp-dep-diff mvn -B -q dependency:tree -DoutputFile=/tmp/dep-tree.txt
                                  docker cp temp-dep-diff:/tmp/dep-tree.txt reports/dep-tree-current.txt || true
                                  docker rm -f temp-dep-diff
                                else
                                  echo "no pom.xml" > reports/dep-tree-current.txt
                                fi
                            '''
                        }
                    }
                }

            }
        }

        stage('3. Flyway 迁移预演') {
            steps {
                script {
                    if (params.SKIP_DB_MIGRATION || params.DRY_RUN) {
                        sh "mkdir -p reports && echo 'Flyway safe no-op: SKIP_DB_MIGRATION=${params.SKIP_DB_MIGRATION}, DRY_RUN=${params.DRY_RUN}' > reports/flyway-info.txt"
                    } else {
                        def has = sh(script: "find . -path '*/db/migration/*.sql' 2>/dev/null | grep -q . && echo yes || echo no", returnStdout: true).trim()
                        if (has == 'yes') {
                        sh '''
                            set -eux; mkdir -p reports
                            PG_HOST=$(kubectl get pod -n ns-data -l app=postgresql -o jsonpath='{.items[0].status.podIP}')
                            docker rm -f temp-flyway || true
                            docker run -d --name temp-flyway --network host \
                              -v $(pwd)/src/main/resources/db/migration:/flyway/sql flyway/flyway:10 sleep 120 || true
                            docker exec temp-flyway flyway \
                              -url="jdbc:postgresql://${PG_HOST}:5432/registry" \
                              -user=postgres -password=devops123 -locations=filesystem:/flyway/sql \
                              info 2>&1 | tee reports/flyway-info.txt || true
                            docker rm -f temp-flyway || true
                        '''
                        } else {
                            sh "mkdir -p reports && echo 'No db migration scripts found.' > reports/flyway-info.txt"
                            echo "⚠️ 无迁移脚本，Flyway 预演 no-op"
                        }
                    }
                }
            }
        }

        stage('4. 产物构建 (Maven Build)') {
            steps {
                unstash 'workspace-src'
                sh '''
                    set -eux
                    if [ -f pom.xml ]; then
                      docker rm -f temp-maven-build || true
                      docker run -d --name temp-maven-build \
                        -v ${MAVEN_CACHE}:/root/.m2 -w /usr/src ${MAVEN_IMAGE} sleep 3600
                      docker cp . temp-maven-build:/usr/src/
                      docker exec temp-maven-build mvn -B -U clean package -DskipTests -Drevision=${SEMVER:-0.0.1}
                      rm -rf target
                      docker cp temp-maven-build:/usr/src/target .
                      docker rm -f temp-maven-build
                    else
                      echo "⚠️ 无 pom.xml，跳过"
                    fi
                '''
            }
        }

        stage('4.5 产物校验与摘要') {
            steps {
                sh '''
                    set -eux; mkdir -p meta
                    if ls target/*.jar >/dev/null 2>&1; then
                      sha256sum target/*.jar | tee meta/artifact.sha256
                      ls -lah target/*.jar | tee meta/artifact.list
                    else
                      echo "no-jar-found" | tee meta/artifact.list
                    fi
                '''
            }
        }

        stage('3.5 JKVideo 全平台构建') {
            parallel {

                stage('JKVideo Android') {
                    steps {
