                                    deleteDir(); unstash 'jkvideo-src'
                                    timeout(time: 20, unit: 'MINUTES') {
                                        sh '''
                                            set -eux
                                            docker rm -f temp-jkvideo-web || true
                                            docker run -d --name temp-jkvideo-web \
                                              -v ${NPM_CACHE}:/root/.npm -w /app node:20-alpine sleep 3600
                                            docker cp jkvideo-src/. temp-jkvideo-web:/app/
                                            docker exec temp-jkvideo-web npm ci --prefer-offline --cache /root/.npm
                                            docker exec temp-jkvideo-web sh -c \
                                              "npx expo export --platform web --output-dir dist/web 2>&1" | cat
                                            mkdir -p reports/jkvideo-web
                                            docker cp temp-jkvideo-web:/app/dist/web/. reports/jkvideo-web/
                                            tar -czf reports/jkvideo-web.tar.gz -C reports/jkvideo-web .
                                            docker rm -f temp-jkvideo-web
