            parallel {

                stage('6.1 镜像漏洞扫描 (Trivy Image)') {
                    steps {
                        script {
                            if (params.SKIP_SECURITY_SCAN || params.DRY_RUN) {
                                sh "mkdir -p reports && echo '{\"status\":\"safe-no-op\",\"SKIP_SECURITY_SCAN\":\"${params.SKIP_SECURITY_SCAN}\",\"DRY_RUN\":\"${params.DRY_RUN}\"}' > reports/trivy-image.json"
                            } else {
                                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                                    sh '''
                                        set -eux; mkdir -p reports
                                        docker run --rm --network host \
                                          -v /var/run/docker.sock:/var/run/docker.sock \
                                          aquasec/trivy:${TRIVY_VER} image \
                                          --db-repository ${TRIVY_DB_REPO} \
                                          --exit-code 0 --severity CRITICAL,HIGH \
                                          --format json ${IMAGE_NAME} | tee reports/trivy-image.json
                                        CRIT=$(grep -c '"Severity":"CRITICAL"' reports/trivy-image.json || true)
                                        HIGH=$(grep -c '"Severity":"HIGH"' reports/trivy-image.json || true)
                                        CRIT=${CRIT:-0}
                                        HIGH=${HIGH:-0}
                                        echo "🔍 漏洞统计: CRITICAL=${CRIT}, HIGH=${HIGH}"
                                        if [ "${CRIT}" -gt 0 ]; then
                                          echo "⚠️ 发现 ${CRIT} 个 CRITICAL 漏洞，已记录，请尽快修复"
                                        else
                                          echo "✅ 无 CRITICAL 漏洞"
                                        fi
                                    '''
                                }
                            }
                        }
                    }
                }

                stage('6.2 SBOM 生成') {
                    steps {
