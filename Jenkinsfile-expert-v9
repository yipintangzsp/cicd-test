                        ═══════════════════════════════════════════════════════
                        DevSecOps × BigData × GitOps — Build Summary
                        ═══════════════════════════════════════════════════════
                        Script       : ${env.SCRIPT_NAME}
                        SemVer       : v${env.SEMVER}
                        Image        : ${env.IMAGE_NAME}
                        JKVideo Web  : ${env.JKVIDEO_WEB_IMAGE}
                        Build        : #${env.BUILD_NUMBER}
                        Deploy Env   : ${params.DEPLOY_ENV}
                        Strategy     : ${params.DEPLOY_STRATEGY}
                        Git Branch   : ${env.GIT_BRANCH_NAME}
                        Git Commit   : ${env.GIT_COMMIT_ID}
                        Git Author   : ${env.GIT_AUTHOR}
                        Commit Msg   : ${env.GIT_COMMIT_MSG}
                        Flink Mode   : ${params.FLINK_RUN_MODE}
                        Dry Run      : ${params.DRY_RUN}
                        Sign Image   : ${params.SIGN_IMAGE}
                        MinIO Upload : ${params.UPLOAD_TO_MINIO}
                        Airflow DAG  : ${params.TRIGGER_AIRFLOW_DAG}
                        Trino Check  : ${params.CHECK_TRINO_QUERY}
                        ArgoCD Verify: ${params.VERIFY_ARGOCD_SYNC}
                        ═══════════════════════════════════════════════════════
                        """.stripIndent()
                    writeFile file: 'meta/build-summary.txt', text: summary
                    sh 'cat meta/build-summary.txt'

                    if (!params.DRY_RUN) {
                        try {
                            withCredentials([usernamePassword(
                                credentialsId: "${env.GITOPS_CREDENTIALS}",
                                usernameVariable: 'GIT_USERNAME',
                                passwordVariable: 'GIT_PASSWORD'
                            )]) {
                                sh """
                                    git config user.email "jenkins@devops.local"
                                    git config user.name "jenkins-bot"
                                    git tag -a v${env.SEMVER} -m "Jenkins #${env.BUILD_NUMBER}" || true
                                    git push http://\${GIT_USERNAME}:\${GIT_PASSWORD}@gitlab-service/root/${env.APP_NAME}.git v${env.SEMVER} || true
                                    echo "✅ Git tag v${env.SEMVER}"
                                """
                            }
                        } catch (e) { echo "⚠️ Git tag 推送失败: ${e.message}" }
                    }
                    echo "✅ V9 流水线闭环执行成功 🎉"
                }
            }
        }

    }

        post {
            success {
                script { H.notifyDingTalk('SUCCESS', "✅ v${env.SEMVER} 发布成功 | ${params.DEPLOY_ENV} | ${params.DEPLOY_STRATEGY}") }
            }
            unstable {
                script { H.notifyDingTalk('UNSTABLE', "⚠️ v${env.SEMVER} UNSTABLE | 请检查报告") }
            }
            failure {
                script {
                    H.notifyDingTalk('FAILURE', "❌ v${env.SEMVER} 构建失败 | ${params.DEPLOY_ENV}")
                    // 只在真正失败（非 UNSTABLE）时才执行回滚
                    if (!params.DRY_RUN && env.DEPLOY_STARTED == 'true' && currentBuild.result != 'UNSTABLE') {
                        sleep(params.ROLLBACK_TIMEOUT.toInteger())
                        H.autoRollback(params.DEPLOY_STRATEGY, env.APP_NAME,
                                    params.K8S_NAMESPACE, env.PREV_DEPLOY_REV,
                                    env.PREV_SVC_SELECTOR)
                    }
                }
            }
            always {
                archiveArtifacts allowEmptyArchive: true, artifacts: 'target/*.jar,meta/**,reports/**', fingerprint: true
                sh '''
                    docker rm -f temp-trivy-fs temp-sonar-scan temp-maven-test \
                    temp-jkvideo-jest temp-jkvideo-web temp-db-check temp-dep-diff \
                    temp-flyway temp-maven-build temp-curl-uploader temp-minio-up \
                    temp-infra-check temp-loki-check temp-airflow-trigger temp-trino-check \
                    2>/dev/null || true
                '''
                cleanWs(deleteDirs: true, disableDeferredWipeout: true, notFailBuild: true)
            }
        }
}
