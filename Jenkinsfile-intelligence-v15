                          echo "missing marker ${marker} at ${url}" >&2
                          test -s "$output" && tail -c 500 "$output" >&2 || true
                          return 1
                        }
                        if wait_for_marker "http://192.168.1.58:${V15_PORTAL_NODEPORT}/" 'Big Data Application Lab' reports/v15-portal/internal.verify.html; then
                          require_marker reports/v15-portal/internal.verify.html 'v15-sonic-command-20260601' 'internal NodePort'
                          require_marker reports/v15-portal/internal.verify.html 'AudioContext' 'internal NodePort'
                          require_marker reports/v15-portal/internal.verify.html 'Sound ON' 'internal NodePort'
                          require_marker reports/v15-portal/internal.verify.html 'sound-rev-v2' 'internal NodePort'
                          wait_for_marker "http://192.168.1.58:${V15_PORTAL_NODEPORT}/evidence.json" 'intelligenceScore' reports/v15-portal/evidence.verify.json || fail_or_warn_verify "internal NodePort evidence.json did not expose intelligenceScore"
                        else
                          fail_or_warn_verify "internal NodePort verification failed; checking Cloudflare public fallback"
                        fi
                        if wait_for_marker "https://${CLOUDFLARE_PUBLIC_HOSTNAME}/" 'Big Data Application Lab' reports/v15-portal/public.verify.html; then
                          require_marker reports/v15-portal/public.verify.html 'v15-sonic-command-20260601' 'public hostname'
                          require_marker reports/v15-portal/public.verify.html 'AudioContext' 'public hostname'
                          require_marker reports/v15-portal/public.verify.html 'Sound ON' 'public hostname'
                          require_marker reports/v15-portal/public.verify.html 'sound-rev-v2' 'public hostname'
                          wait_for_marker "https://${CLOUDFLARE_PUBLIC_HOSTNAME}/evidence.json" 'intelligenceScore' reports/v15-portal/public-evidence.verify.json || fail_or_warn_verify "public evidence.json did not expose intelligenceScore"
                        else
                          fail_or_warn_verify "public hostname verification failed inside Jenkins; checking local Cloudflare origin bridge 127.0.0.1:30087"
                          if wait_for_marker "http://127.0.0.1:30087/" 'v15-sonic-command-20260601' reports/v15-portal/public-origin-bridge.verify.html; then
                            require_marker reports/v15-portal/public-origin-bridge.verify.html 'sound-rev-v2' 'local Cloudflare origin bridge'
                          else
                            fail_or_warn_verify "local Cloudflare origin bridge verification failed"
                          fi
                        fi
                        timeout 20s kubectl get deploy,svc -n ${V15_PORTAL_NAMESPACE} -l app.kubernetes.io/name=${V15_PORTAL_APP_LABEL} -o wide | tee reports/v15-portal/k8s-live.txt || true
                        curl -fsS --max-time 20 "https://${CLOUDFLARE_PUBLIC_HOSTNAME}/evidence.json" -o reports/v15-portal/public-current-evidence.json || true
                        node - <<'NODE'
const fs = require('fs');
function readJson(file) {
  try { return JSON.parse(fs.readFileSync(file, 'utf8')); } catch { return null; }
}
const generated = readJson('reports/v15-portal/evidence.json') || {};
const publicEvidence = readJson('reports/v15-portal/public-current-evidence.json') || {};
const generatedSummary = generated.summary || {};
const publicSummary = publicEvidence.summary || {};
const generatedVersion = generatedSummary.pipeline_version || generatedSummary.pipelineVersion || 'unknown';
const publicVersion = publicSummary.pipeline_version || publicSummary.pipelineVersion || 'unknown';
const generatedBuild = generatedSummary.build || 'unknown';
const publicBuild = publicSummary.build || 'unknown';
const diagnosis = {
  publicHost: process.env.CLOUDFLARE_PUBLIC_HOSTNAME,
  internalNodePort: process.env.V15_PORTAL_NODEPORT,
  generatedVersion,
  generatedBuild,
  publicVersion,
  publicBuild,
  state: generatedVersion === publicVersion ? 'aligned' : 'public-route-stale',
  action: generatedVersion === publicVersion
    ? 'No public route action needed.'
    : 'Public hostname still serves an older portal. Update the Cloudflare tunnel/origin route to the V15 NodePort or publish service.'
};
fs.writeFileSync('reports/v15-portal/public-route-diagnosis.json', JSON.stringify(diagnosis, null, 2) + '\\n');
console.log('public_route_state=' + diagnosis.state);
console.log('public_route_generated=' + diagnosis.generatedVersion + '#' + diagnosis.generatedBuild);
console.log('public_route_current=' + diagnosis.publicVersion + '#' + diagnosis.publicBuild);
NODE
                    '''
                }

                stage('V15.95 最终结论与归档') {
                    sh '''
                        set -eu
                        cat > reports/v15-release-verdict.json <<EOF2
{
  "pipeline": "Jenkinsfile-intelligence-v15",
  "inherits": "Jenkinsfile-intelligence-v14",
  "build": "${BUILD_NUMBER}",
  "commit": "${GIT_COMMIT_ID}",
  "internal_portal": "http://192.168.1.58:${V15_PORTAL_NODEPORT}/",
  "public_portal": "https://${CLOUDFLARE_PUBLIC_HOSTNAME}/",
  "grafana_uid": "zhanglab-v15-platform-intelligence",
  "kibana_index_prefix": "${V15_KIBANA_INDEX_PREFIX}",
  "stage_plan_count": "$(wc -l < reports/v15-stage-plan.txt | tr -d ' ')",
  "mutation_policy": "no data deletion, no pvc deletion, no backup deletion, no cluster reset"
}
EOF2
                        cat reports/v15-release-verdict.json
                    '''
                }
            } catch (err) {
                currentBuild.result = 'FAILURE'
                throw err
            } finally {
                archiveArtifacts allowEmptyArchive: true, artifacts: 'meta/**,reports/**', fingerprint: true
                cleanWs(deleteDirs: true, disableDeferredWipeout: true, notFailBuild: true)
            }
        }
    }
}

if (env.NODE_NAME) {
    runV15()
} else {
    node {
        runV15()
