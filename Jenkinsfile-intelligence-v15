                              mv "$tmp" "$output"
                              rm -f "${tmp}.err"
                              return 0
                            fi
                            printf '[%s] %s attempt=%s failed: %s\\n' "$(date -u +%FT%TZ)" "$title" "$attempt" "$(cat "${tmp}.err" 2>/dev/null)" >> meta/v15-cluster-capture-errors.log
