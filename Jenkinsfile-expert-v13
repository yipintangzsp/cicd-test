                          url="$1"
                          case "$url" in
                            http://*.svc.cluster.local*|https://*.svc.cluster.local*) ;;
                            *) printf '%s' "$url"; return 0 ;;
                          esac
                          scheme="${url%%://*}"
                          rest="${url#*://}"
                          hostport="${rest%%/*}"
                          path="${rest#"$hostport"}"
                          [ "$path" != "$rest" ] || path="/"
                          host="${hostport%%:*}"
                          portpart="${hostport#"$host"}"
                          svc="${host%%.*}"
                          remainder="${host#*.}"
                          ns="${remainder%%.*}"
                          ip="$(command kubectl -n "$ns" get svc "$svc" -o jsonpath='{.spec.clusterIP}' 2>/dev/null || true)"
                          if [ -n "$ip" ] && [ "$ip" != "None" ]; then
                            printf '%s://%s%s%s' "$scheme" "$ip" "$portpart" "$path"
                          else
                            printf '%s' "$url"
                          fi
                        }
                        PRIMARY_URL="$(cluster_url "http://${V13_PORTAL_SERVICE_NAME}.${V13_PORTAL_NAMESPACE}.svc.cluster.local/")"
                        COMPAT_URL="$(cluster_url "http://hello-app-v10-portal.${V13_PORTAL_NAMESPACE}.svc.cluster.local/")"
                        curl -fsS --max-time 10 "$PRIMARY_URL" | grep -q 'ZhangLab DevOps V13 Control Surface'
                        curl -fsS --max-time 10 "$COMPAT_URL" | grep -q 'ZhangLab DevOps V13 Control Surface'
                        curl -fsS --max-time 10 "https://${CLOUDFLARE_PUBLIC_HOSTNAME}/" | grep -q 'ZhangLab DevOps V13 Control Surface'
                        kubectl get deploy,svc -n ${V13_PORTAL_NAMESPACE} -l app.kubernetes.io/name=platform-era-v13-portal -o wide | tee reports/v13-portal-k8s.txt
                        kubectl get svc -n ${V13_PORTAL_NAMESPACE} hello-app-v10-portal -o wide | tee -a reports/v13-portal-k8s.txt
                    '''
                }

                postPortalAddonStages.each { item ->
                    stage(item[0]) {
                        sh "bash ci/v13_addon_checks.sh ${item[1]}"
                    }
                }

                stage('11. 复杂度与安全审计') {
                    sh '''
                        set -eu
                        mkdir -p reports/v13-complexity
                        wc -l reports/v13-stage-plan.txt | tee reports/v13-complexity/runtime-stage-count.txt
                        REQUIRED=$(( (77 * 3 + 1) / 2 ))
                        ACTUAL=$(wc -l < reports/v13-stage-plan.txt | tr -d ' ')
                        [ "$ACTUAL" -ge "$REQUIRED" ] || { echo "v13 runtime stage count $ACTUAL is below required $REQUIRED"; exit 1; }
                        P1='rm -''rf'
                        P2='kubectl de''lete'
                        P3='helm un''install'
                        P4='docker system pr''une'
                        P5='trun''cate'
                        P6='mk''fs'
                        P7='dd i''f='
                        P8='drop data''base'
                        grep -RInE "$P1|$P2|$P3|$P4|$P5|$P6|$P7|$P8" Jenkinsfile-epoch-v13 jenkins-v13-governance.groovy ci/v13_generate_governance.mjs ci/v13_addon_checks.sh Jenkinsfile-router > reports/v13-complexity/destructive-scan.txt || true
                        [ ! -s reports/v13-complexity/destructive-scan.txt ] || { cat reports/v13-complexity/destructive-scan.txt; exit 1; }
                        FLOATING=':lat''est'
                        grep -RIn "$FLOATING" Jenkinsfile-epoch-v13 jenkins-v13-governance.groovy ci/v13_generate_governance.mjs ci/v13_addon_checks.sh > reports/v13-complexity/floating-tags.txt || true
                        [ ! -s reports/v13-complexity/floating-tags.txt ] || { cat reports/v13-complexity/floating-tags.txt; exit 1; }
                    '''
                    V13.auditV13DestructiveCommands()
                    V13.validateV13ArtifactCompleteness()
                    sh 'mkdir -p reports/v13-stage-manifest && cp reports/v13-stage-plan.txt reports/v13-stage-manifest/stages.txt && nl -ba reports/v13-stage-manifest/stages.txt | tee reports/v13-stage-manifest/stage-count.txt'
                }

                stage('12. 真实发布结论与回滚证据包') {
                    sh '''
                        set -eu
                        mkdir -p reports/v13-release-verdict
                        cat > reports/v13-release-verdict/verdict.json <<EOF2
{
  "pipeline": "Jenkinsfile-epoch-v13",
  "build": "${BUILD_NUMBER}",
  "commit": "${GIT_COMMIT_ID}",
	  "internal_portal": "http://192.168.1.58:${V13_PORTAL_NODEPORT}/",
	  "primary_portal_service": "${V13_PORTAL_SERVICE_NAME}.${V13_PORTAL_NAMESPACE}.svc.cluster.local",
	  "compatibility_nodeport_service": "hello-app-v10-portal.${V13_PORTAL_NAMESPACE}.svc.cluster.local",
	  "cloudflare_hostname": "${CLOUDFLARE_PUBLIC_HOSTNAME}",
	  "runtime_stage_plan": "$(wc -l < reports/v13-stage-plan.txt | tr -d ' ')",
  "rollback_scope": "v13 portal/cloudflared resources only; no PVC or backup deletion"
}
EOF2
                        cat reports/v13-release-verdict/verdict.json
                    '''
                }
            } catch (err) {
                currentBuild.result = 'FAILURE'
                throw err
            } finally {
                if (V13 != null) {
                    def finalResult = currentBuild.currentResult ?: (currentBuild.result ?: 'SUCCESS')
                    V13.publishV13FinalBuildRecord("${p('V13_KIBANA_INDEX_PREFIX', 'jenkins-v13-governance')}", finalResult, currentBuild.duration ?: 0)
                }
                archiveArtifacts allowEmptyArchive: true, artifacts: 'meta/**,reports/**', fingerprint: true
                cleanWs(deleteDirs: true, disableDeferredWipeout: true, notFailBuild: true)
            }
        }
    }
}

if (env.NODE_NAME) {
    runV13()
} else {
    node {
        runV13()
    }
}
