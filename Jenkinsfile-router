        booleanParam(name: 'V15_PUBLISH_PORTAL', defaultValue: true, description: '[v15] Publish the V15 autonomous DataOps portal.'),
        booleanParam(name: 'V15_IMPORT_OBSERVABILITY_ASSETS', defaultValue: true, description: '[v15] Import V15 Elasticsearch, Kibana and Grafana autonomous assets.'),
        booleanParam(name: 'V15_STRICT_RISK_GATE', defaultValue: false, description: '[v15] Keep false unless high-risk findings should fail the build.'),
        booleanParam(name: 'V15_RUN_V14_FOUNDATION', defaultValue: false, description: '[v15] Default false: inherit live V14 evidence instead of rerunning full V14.'),
        string(name: 'V15_GRAFANA_DASHBOARD_TITLE', defaultValue: 'ZhangLab V15 Autonomous DataOps Intelligence', description: '[v15] Grafana dashboard title.'),
        string(name: 'V15_KIBANA_INDEX_PREFIX', defaultValue: 'jenkins-v15-autonomous', description: '[v15] Kibana/Elasticsearch index prefix.'),
        string(name: 'V15_PORTAL_NAMESPACE', defaultValue: 'ns-apps', description: '[v15] Portal namespace.'),
        string(name: 'V15_PORTAL_SERVICE_NAME', defaultValue: 'platform-era-v13-portal', description: '[v15] Reuse public portal service unless intentionally separated.'),
        string(name: 'V15_PORTAL_APP_LABEL', defaultValue: 'platform-era-v13-portal', description: '[v15] Portal pod label used by the service selector.'),
        string(name: 'V15_PORTAL_NODEPORT', defaultValue: '30089', description: '[v15] Public portal NodePort behind Cloudflare.'),
        booleanParam(name: 'V15_PROMOTE_LEGACY_PUBLIC_NODEPORT', defaultValue: true, description: '[v15] Promote legacy Cloudflare-facing 30087 service to V15 after V15 portal is ready.'),
        string(name: 'V15_LEGACY_PUBLIC_SERVICE_NAME', defaultValue: 'hello-app-v10-portal', description: '[v15] Existing service currently used by Cloudflare public route.'),
        string(name: 'V15_LEGACY_PUBLIC_NODEPORT', defaultValue: '30087', description: '[v15] Existing public NodePort currently serving the Cloudflare route.'),
        string(name: 'CLOUDFLARE_PUBLIC_HOSTNAME', defaultValue: 'platform.heil.ccwu.cc', description: '[v13] Cloudflare public hostname.'),
        string(name: 'CLOUDFLARE_TUNNEL_SECRET', defaultValue: 'cloudflare-v11-tunnel-token', description: '[v13] Kubernetes Secret containing Cloudflare Tunnel token.'),
        string(name: 'CLOUDFLARE_TUNNEL_IMAGE', defaultValue: '127.0.0.1:30050/library/cloudflared:2026.5.0', description: '[v13] Cloudflare Tunnel local image with pinned tag.')
    ])
])

node {
    stage('Select Jenkinsfile') {
        checkout scm
        def selected = (params.PIPELINE_VERSION ?: 'Jenkinsfile-intelligence-v15').trim()
        if (!pipelineVersions.contains(selected)) {
            error "Unsupported PIPELINE_VERSION: ${selected}"
        }
        if (!fileExists(selected)) {
            error "Selected Jenkinsfile does not exist: ${selected}"
        }
        currentBuild.displayName = "#${env.BUILD_NUMBER} ${selected}"
        currentBuild.description = "router=${selected}"
        echo "Dispatching to ${selected}"
        load selected
    }
}
