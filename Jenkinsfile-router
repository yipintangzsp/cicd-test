// V13 epoch router. This job is independent from hello-app but inherits V12 evidence patterns.

def pipelineVersions = [
    'Jenkinsfile-epoch-v13'
]

properties([
    disableConcurrentBuilds(),
    buildDiscarder(logRotator(numToKeepStr: '45', artifactNumToKeepStr: '30')),
    pipelineTriggers([
        gitlab(
            triggerOnPush: true,
            triggerToBranchDeleteRequest: false,
            triggerOnMergeRequest: false,
            triggerOnlyIfNewCommitsPushed: true,
            triggerOnPipelineEvent: false,
            triggerOnAcceptedMergeRequest: false,
            triggerOnClosedMergeRequest: false,
            triggerOnApprovedMergeRequest: false,
            triggerOpenMergeRequestOnPush: 'never',
            triggerOnNoteRequest: false,
            ciSkip: true,
            skipWorkInProgressMergeRequest: true,
            setBuildDescription: true,
            branchFilterType: 'NameBasedFilter',
            includeBranchesSpec: 'main',
            excludeBranchesSpec: '',
            secretToken: 'platform-era-v13-gitlab-webhook-20260525',
            cancelPendingBuildsOnUpdate: false
        )
    ]),
    parameters([
        choice(name: 'PIPELINE_VERSION', choices: pipelineVersions, description: 'V13 new-era pipeline entry.'),
        choice(name: 'DEPLOY_ENV', choices: ['dev', 'test', 'prod'], description: 'Target environment label.'),
        booleanParam(name: 'DRY_RUN', defaultValue: false, description: 'Run build/publish path by default; enable only for validation-only execution.'),
        booleanParam(name: 'RUN_UNIT_TESTS', defaultValue: true, description: 'Keep inherited build/test checks enabled.'),
        booleanParam(name: 'RUN_SMOKE_TEST', defaultValue: true, description: 'Run smoke checks after evidence portal publication.'),
        booleanParam(name: 'V13_PLATFORM_MATRIX', defaultValue: true, description: '[v13] Generate platform evidence matrix.'),
        booleanParam(name: 'V13_PUBLISH_PORTAL', defaultValue: true, description: '[v13] Publish Cloudflare-ready governance portal.'),
        booleanParam(name: 'V13_RUN_PLATFORM_PROBES', defaultValue: true, description: '[v13] Probe every platform service and record evidence.'),
        booleanParam(name: 'V13_STRICT_SERVICE_READY', defaultValue: false, description: '[v13] Fail on a service probe failure. Keep false for governance patrol.'),
        booleanParam(name: 'V13_IMPORT_OBSERVABILITY_ASSETS', defaultValue: true, description: '[v13] Import/push Elasticsearch, Kibana and Grafana evidence.'),
        booleanParam(name: 'V13_INCLUDE_RESOURCE_PROFILE', defaultValue: true, description: '[v13] Collect node/pod capacity evidence.'),
        booleanParam(name: 'V13_INCLUDE_POD_LOG_SAMPLE', defaultValue: true, description: '[v13] Collect bounded log samples from key services.'),
        booleanParam(name: 'V13_NOTIFY_DINGTALK', defaultValue: true, description: '[v13] Generate/send DingTalk summary when webhook credentials exist.'),
        string(name: 'V13_SERVICE_PROBE_TIMEOUT', defaultValue: '8', description: '[v13] HTTP service probe timeout in seconds.'),
        string(name: 'V13_GRAFANA_DASHBOARD_TITLE', defaultValue: 'ZhangLab V13 Governance Era', description: '[v13] Grafana dashboard title.'),
        string(name: 'V13_KIBANA_INDEX_PREFIX', defaultValue: 'jenkins-v13-governance', description: '[v13] Kibana/Elasticsearch index prefix.'),
        string(name: 'V13_PORTAL_NAMESPACE', defaultValue: 'ns-apps', description: '[v13] Evidence portal namespace.'),
        string(name: 'V13_PORTAL_NODEPORT', defaultValue: '30087', description: '[v13] Existing public portal NodePort.'),
        booleanParam(name: 'V13_REQUIRE_CLOUDFLARE_PUBLICATION', defaultValue: true, description: '[v13] Fail when Cloudflare public portal cannot be verified.'),
        booleanParam(name: 'V13_REQUIRE_NO_IDLE_CORE_SERVICE', defaultValue: false, description: '[v13] Fail when suspicious idle core service is found.'),
        string(name: 'CLOUDFLARE_PUBLIC_HOSTNAME', defaultValue: 'platform.heil.ccwu.cc', description: '[v13] Cloudflare public hostname.'),
        string(name: 'CLOUDFLARE_TUNNEL_SECRET', defaultValue: 'cloudflare-v11-tunnel-token', description: '[v13] Kubernetes Secret containing Cloudflare Tunnel token.'),
        string(name: 'CLOUDFLARE_TUNNEL_IMAGE', defaultValue: '127.0.0.1:30050/library/cloudflared:2026.5.0', description: '[v13] Pinned local Cloudflare Tunnel image.')
    ])
])

node {
    stage('Select V13 Epoch Jenkinsfile') {
        checkout scm
        def selected = (params.PIPELINE_VERSION ?: 'Jenkinsfile-epoch-v13').trim()
        if (!pipelineVersions.contains(selected)) {
            error "Unsupported PIPELINE_VERSION: ${selected}"
        }
        if (!fileExists(selected)) {
            error "Selected Jenkinsfile does not exist: ${selected}"
        }
        currentBuild.displayName = "#${env.BUILD_NUMBER} ${selected}"
        currentBuild.description = "new-era-router=${selected}"
        load selected
    }
}
